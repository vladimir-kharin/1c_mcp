// Обезличивание данных, которые MCP-сервер передает агенту ИИ.
//
// Модуль хранит универсальную часть механизма: настройки базы (включено ли обезличивание и правила),
// проверку "закрыто ли поле", преобразование значений в токены и метки, шифрование токенов.
// Разбор данных конкретного инструмента (текста запроса, записей журнала) делает сам инструмент.
//
// Пока обезличивание выключено (по умолчанию), модуль ни на что не влияет: Включено() возвращает Ложь,
// и инструменты выдают данные как есть.

#Область ПрограммныйИнтерфейс

// Возвращает, включено ли обезличивание данных в информационной базе.
// Значение кешируется на сеанс: изменение настроек действует в новых сеансах.
//
// Возвращаемое значение:
//  Булево
//
Функция Включено() Экспорт

	Возврат mcp_КонтейнерыПовтИсп.НастройкиОбезличивания().Включено;

КонецФункции

// Создает контекст обезличивания одного вызова инструмента: настройки сеанса и кеши преобразований.
// Вызывается только при включенном обезличивании.
//
// Возвращаемое значение:
//  Структура:
//   * Настройки - ФиксированнаяСтруктура - см. НастройкиСеанса
//   * ГруппыТипов - Соответствие из КлючИЗначение - Тип -> группа типа, см. ГруппаТипаПриОбезличивании
//   * Токены - Соответствие из КлючИЗначение - ссылка -> токен
//   * Метки - Соответствие из КлючИЗначение - строка -> метка
//   * КлассыПравил - Массив из Строка - см. КлассыПравил
//
Функция НовыйКонтекст() Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Настройки", mcp_КонтейнерыПовтИсп.НастройкиОбезличивания());
	Контекст.Вставить("ГруппыТипов", Новый Соответствие);
	Контекст.Вставить("Токены", Новый Соответствие);
	Контекст.Вставить("Метки", Новый Соответствие);
	Контекст.Вставить("КлассыПравил", КлассыПравил());

	Возврат Контекст;

КонецФункции

// Проверяет, закрыто ли поле объекта правилами: правилом на объект целиком, на табличную часть поля или на это поле.
//
// Параметры:
//  Объект - Строка - полное имя объекта метаданных, см. ОписаниеТаблицы
//  ПолеПравила - Строка - имя поля в правиле после имени объекта, см. ПолеТаблицы
//  Контекст - Структура - см. НовыйКонтекст
//  Причина - Строка - выходной: "закрыто правилом <правило>", если поле закрыто
//
// Возвращаемое значение:
//  Булево
//
Функция ПолеЗакрыто(Объект, ПолеПравила, Контекст, Причина = "") Экспорт

	Правила = ПравилаОбъектов(Объект + "." + ПолеПравила, Контекст);
	Если Правила.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Причина = СтрШаблон(НСтр("ru = 'закрыто правилом %1'"), Правила[0]);
	Возврат Истина;

КонецФункции

// Возвращает правила обезличивания, которые касаются объектов или полей метаданных.
// Для объекта - правила на объект целиком, на его табличные части и поля: при любом из них ссылки на объект
// заменяются токенами. Для поля - правила, которые его закрывают: на объект целиком, на табличную часть или на само поле.
// Пока обезличивание выключено, правил нет.
//
// Параметры:
//  Объекты - Тип, ОписаниеТипов, ОбъектМетаданных, Строка, Массив из Тип, ОписаниеТипов, ОбъектМетаданных, Строка:
//            тип значения (проверяется объект метаданных типа, у составного типа - каждого из типов);
//            объект метаданных или его реквизит, измерение, ресурс, реквизит табличной части;
//            полное имя объекта ("Справочник.Контрагенты") или поля в виде правила ("Справочник.Контрагенты.ИНН",
//            "Документ.Заказ.Товары.Цена"); массив из перечисленного (например, поле "Метаданные" журнала
//            регистрации у событий доступа). Типы без объекта метаданных и прочие значения пропускаются
//  Контекст - Структура, Неопределено - см. НовыйКонтекст; Неопределено - настройки сеанса
//
// Возвращаемое значение:
//  Массив из Строка - правила без повторов: сначала на объект и поле, затем на вложенные поля; пустой - правил нет
//
// Пример:
//  Если mcp_Обезличивание.ЕстьПравила(ТипЗнч(Ссылка)) Тогда ...
//  Правила = mcp_Обезличивание.ПравилаОбъектов("Справочник.Контрагенты.ИНН");
//
Функция ПравилаОбъектов(Объекты, Контекст = Неопределено) Экспорт

	Если Контекст = Неопределено Тогда
		Правила = mcp_КонтейнерыПовтИсп.НастройкиОбезличивания().Правила;
	Иначе
		Правила = Контекст.Настройки.Правила;
	КонецЕсли;

	Результат = Новый Массив;
	Если Правила.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Имена = Новый Массив;
	ДобавитьИменаВПравилах(Объекты, Имена);
	Добавленные = Новый Соответствие;
	Для Каждого Имя Из Имена Цикл
		// Правила на сам элемент и на то, что его содержит
		Сегменты = СтрРазделить(Имя, ".");
		Префикс  = Сегменты[0];
		Для Номер = 1 По Сегменты.ВГраница() Цикл
			Префикс = Префикс + "." + Сегменты[Номер];
			ДобавитьПравило(Правила, Префикс, Результат, Добавленные);
		КонецЦикла;
		// Правила на вложенные поля
		НачалоВложенных = Имя + ".";
		Для Каждого Правило Из Правила Цикл
			Если СтрНачинаетсяС(Правило.Ключ, НачалоВложенных) Тогда
				ДобавитьПравило(Правила, Правило.Ключ, Результат, Добавленные);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, касается ли объектов или полей метаданных хотя бы одно правило обезличивания.
//
// Параметры:
//  Объекты - см. ПравилаОбъектов
//  Контекст - см. ПравилаОбъектов
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьПравила(Объекты, Контекст = Неопределено) Экспорт

	Возврат ПравилаОбъектов(Объекты, Контекст).Количество() > 0;

КонецФункции

// Возвращает настройку обезличивания, которую инструмент хранит вместе с настройками обезличивания базы
// (например, уровень обезличивания журнала регистрации). Значение кешируется на сеанс; пока обезличивание
// выключено, возвращается значение по умолчанию.
//
// Параметры:
//  ИмяНастройки - Строка - имя, уникальное среди инструментов: например, имя обработки-контейнера
//  ЗначениеПоУмолчанию - Строка, Число, Булево, Дата, Неопределено - если настройка не записана
//
// Возвращаемое значение:
//  Строка, Число, Булево, Дата, Неопределено
//
Функция НастройкаИнструмента(ИмяНастройки, ЗначениеПоУмолчанию = Неопределено) Экспорт

	НастройкиИнструментов = mcp_КонтейнерыПовтИсп.НастройкиОбезличивания().НастройкиИнструментов;
	Значение = НастройкиИнструментов.Получить(ВРег(ИмяНастройки));

	Возврат ?(Значение = Неопределено, ЗначениеПоУмолчанию, Значение);

КонецФункции

// Определяет группу типа: от нее зависит, как обезличиваются значения типа.
//
// Параметры:
//  ТипЗначения - Тип
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Строка - "Открытый" (Null, Неопределено, перечисление) - выдается как есть всегда;
//           "Строка" - в закрытой колонке заменяется меткой;
//           "Примитив" (число, дата, булево) - в закрытой колонке заменяется на Null;
//           "СсылкаОбъектаБезПравил" - в закрытой колонке заменяется токеном;
//           "СсылкаОбъектаСПравилами" - у объекта есть правило: заменяется токеном всегда;
//           "Прочий" - не выдается: заменяется на Null всегда
//
Функция ГруппаТипаПриОбезличивании(ТипЗначения, Контекст) Экспорт

	ГруппаТипаЗначения = Контекст.ГруппыТипов[ТипЗначения];
	Если ГруппаТипаЗначения <> Неопределено Тогда
		Возврат ГруппаТипаЗначения;
	КонецЕсли;

	Если ТипЗначения = Тип("Null") ИЛИ ТипЗначения = Тип("Неопределено") Тогда
		ГруппаТипаЗначения = "Открытый";
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		ГруппаТипаЗначения = "Строка";
	ИначеЕсли ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Дата") ИЛИ ТипЗначения = Тип("Булево") Тогда
		ГруппаТипаЗначения = "Примитив";
	Иначе
		ГруппаТипаЗначения = ГруппаТипаМетаданных(ТипЗначения, Контекст);
	КонецЕсли;
	Контекст.ГруппыТипов.Вставить(ТипЗначения, ГруппаТипаЗначения);

	Возврат ГруппаТипаЗначения;

КонецФункции

// Проверяет, изменит ли обезличивание хотя бы одно значение колонки с таким типом.
//
// Параметры:
//  ТипЗначения - ОписаниеТипов - тип колонки
//  КолонкаЗакрыта - Булево
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Булево
//
Функция КолонкаТребуетОбработки(ТипЗначения, КолонкаЗакрыта, Контекст) Экспорт

	Типы = ТипЗначения.Типы();
	Если Типы.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого ТипКолонки Из Типы Цикл
		ГруппаТипаКолонки = ГруппаТипаПриОбезличивании(ТипКолонки, Контекст);
		Если ГруппаТипаКолонки <> "Открытый"
			И (КолонкаЗакрыта ИЛИ ГруппаТипаКолонки = "СсылкаОбъектаСПравилами" ИЛИ ГруппаТипаКолонки = "Прочий") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Описывает для агента, что обезличивание меняет в открытой колонке: ссылки на объекты с правилами
// и значения типов, которые не выдаются.
//
// Параметры:
//  ТипЗначения - ОписаниеТипов - тип колонки
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Строка - пустая, если значения открытой колонки не меняются
//
Функция ПричинаЗаменыОткрытыхЗначений(ТипЗначения, Контекст) Экспорт

	ОбъектыСПравилами = Новый Массив;
	ЕстьПрочие        = ТипЗначения.Типы().Количество() = 0;
	Для Каждого ТипКолонки Из ТипЗначения.Типы() Цикл
		ГруппаТипаКолонки = ГруппаТипаПриОбезличивании(ТипКолонки, Контекст);
		Если ГруппаТипаКолонки = "СсылкаОбъектаСПравилами" Тогда
			ОбъектыСПравилами.Добавить(Метаданные.НайтиПоТипу(ТипКолонки).ПолноеИмя());
		ИначеЕсли ГруппаТипаКолонки = "Прочий" Тогда
			ЕстьПрочие = Истина;
		КонецЕсли;
	КонецЦикла;

	Части = Новый Массив;
	Если ОбъектыСПравилами.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'ссылки на объекты с правилами (%1) заменены токенами'"),
			СтрСоединить(ОбъектыСПравилами, ", ")));
	КонецЕсли;
	Если ЕстьПрочие Тогда
		Части.Добавить(НСтр("ru = 'значения типов, которые не выдаются при обезличивании, заменены на null'"));
	КонецЕсли;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Обезличивает значение колонки: ссылки - токены, строки - метки, прочие закрытые значения - Null.
//
// Параметры:
//  Значение - Произвольный
//  КолонкаЗакрыта - Булево - Истина, если колонка закрыта правилом или ее источник не определен
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Произвольный - значение для выдачи агенту
//
Функция ОбезличенноеЗначение(Значение, КолонкаЗакрыта, Контекст) Экспорт

	ГруппаТипаЗначения = ГруппаТипаПриОбезличивании(ТипЗнч(Значение), Контекст);
	Если ГруппаТипаЗначения = "Открытый" Тогда
		Возврат Значение;
	ИначеЕсли ГруппаТипаЗначения = "Прочий" Тогда
		Возврат Null;
	ИначеЕсли ГруппаТипаЗначения = "СсылкаОбъектаСПравилами"
		ИЛИ (ГруппаТипаЗначения = "СсылкаОбъектаБезПравил" И КолонкаЗакрыта) Тогда
		Если Значение.Пустая() Тогда
			Возврат Значение;
		КонецЕсли;
		ТокенСсылки = Контекст.Токены[Значение];
		Если ТокенСсылки = Неопределено Тогда
			ТокенСсылки = Токен(Значение, Контекст.Настройки.Ключ);
			Контекст.Токены.Вставить(Значение, ТокенСсылки);
		КонецЕсли;
		Возврат ТокенСсылки;
	ИначеЕсли НЕ КолонкаЗакрыта Тогда
		Возврат Значение;
	ИначеЕсли ГруппаТипаЗначения = "Строка" Тогда
		МеткаСтроки = Контекст.Метки[Значение];
		Если МеткаСтроки = Неопределено Тогда
			МеткаСтроки = Метка(Значение, Контекст.Настройки.Ключ);
			Контекст.Метки.Вставить(Значение, МеткаСтроки);
		КонецЕсли;
		Возврат МеткаСтроки;
	КонецЕсли;

	Возврат Null;

КонецФункции

// Обезличивает значение вместе с вложенными: коллекции - по элементам, элементы - см. ОбезличенноеЗначение.
// В закрытом значении ключи структур и соответствий и имена колонок таблиц значений обезличиваются как данные;
// в открытом заменяются только ссылки на объекты с правилами и значения, которые не выдаются.
//
// Параметры:
//  Значение - Произвольный
//  Контекст - Структура - см. НовыйКонтекст
//  Закрыто - Булево - Истина, если значение закрыто правилом или его источник не определен
//
// Возвращаемое значение:
//  Произвольный - Соответствие вместо структуры и соответствия, Массив из Соответствие вместо таблицы значений,
//                 Массив вместо фиксированного массива
//
Функция ОбезличенноеЗначениеДанных(Значение, Контекст, Закрыто = Истина) Экспорт

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(?(Закрыто, ОбезличенныйКлюч(КлючИЗначение.Ключ, Контекст), КлючИЗначение.Ключ),
				ОбезличенноеЗначениеДанных(КлючИЗначение.Значение, Контекст, Закрыто));
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Массив") ИЛИ ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ОбезличенноеЗначениеДанных(Элемент, Контекст, Закрыто));
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = Новый Массив;
		Для Каждого СтрокаТаблицы Из Значение Цикл
			ЗначенияСтроки = Новый Соответствие;
			Для Каждого Колонка Из Значение.Колонки Цикл
				ЗначенияСтроки.Вставить(?(Закрыто, ОбезличенныйКлюч(Колонка.Имя, Контекст), Колонка.Имя),
					ОбезличенноеЗначениеДанных(СтрокаТаблицы[Колонка.Имя], Контекст, Закрыто));
			КонецЦикла;
			Результат.Добавить(ЗначенияСтроки);
		КонецЦикла;
	Иначе
		Результат = ОбезличенноеЗначение(Значение, Закрыто, Контекст);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Заменяет значения колонки таблицы. Имя и позиция колонки сохраняются, тип снимается:
// токены и метки - строки, а колонка могла быть ссылочной или числовой.
//
// Параметры:
//  Таблица - ТаблицаЗначений
//  Колонка - КолонкаТаблицыЗначений - заменяемая колонка
//  Значения - Массив - значения по строкам
//
Процедура ЗаменитьКолонку(Таблица, Колонка, Значения) Экспорт

	ИмяКолонки   = Колонка.Имя;
	НоваяКолонка = Таблица.Колонки.Вставить(Таблица.Колонки.Индекс(Колонка),
		"К" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
	Таблица.ЗагрузитьКолонку(Значения, НоваяКолонка);
	Таблица.Колонки.Удалить(Колонка);
	НоваяКолонка.Имя = ИмяКолонки;

КонецПроцедуры

// Возвращает ссылку, зашифрованную в токене.
//
// Параметры:
//  Токен - Строка - кандидат в токен <ПолноеИмя>·<32 hex>, регистр кода любой
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - Неопределено, если строка не является токеном
//
Функция СсылкаПоТокену(Токен, Контекст) Экспорт

	ДлинаКода = 32;
	ПозицияРазделителя = СтрНайти(Токен, РазделительТокена());
	КодТокена = Сред(Токен, ПозицияРазделителя + 1);
	Если ПозицияРазделителя = 0 ИЛИ СтрДлина(КодТокена) <> ДлинаКода Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Лев(Токен, ПозицияРазделителя - 1));
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	КлассИИмя = СтрРазделить(ПолноеИмя, ".");
	Если КлассИИмя.ВГраница() <> 1 ИЛИ КлассыТокенов().Найти(КлассИИмя[0]) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Блок = ПолучитьБуферДвоичныхДанныхИзHexСтроки(КодТокена);
	Если ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Блок) <> ВРег(КодТокена) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Код = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(
		ПреобразоватьФейстелем(Блок, ПолноеИмя, Контекст.Настройки.Ключ, Истина));
	ДлиныГруппУИД = "8,4,4,4,12";
	ГруппыУИД     = Новый Массив;
	Позиция       = 1;
	Для Каждого ДлинаГруппы Из СтрРазделить(ДлиныГруппУИД, ",") Цикл
		ГруппыУИД.Добавить(Сред(Код, Позиция, Число(ДлинаГруппы)));
		Позиция = Позиция + Число(ДлинаГруппы);
	КонецЦикла;

	Возврат XMLЗначение(Тип(КлассИИмя[0] + "Ссылка." + КлассИИмя[1]), СтрСоединить(ГруппыУИД, "-"));

КонецФункции

// Возвращаемое значение:
//  Строка - символ между полным именем объекта и кодом в токене
//
Функция РазделительТокена() Экспорт

	Возврат "·";

КонецФункции

// Описывает таблицу запроса по ее имени.
//
// Параметры:
//  ИмяТаблицы - Строка - имя таблицы запроса: объект, его табличная часть или виртуальная таблица
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если объект метаданных не найден:
//   * Объект - Строка - полное имя объекта метаданных
//   * ОбъектМетаданных - ОбъектМетаданных
//   * ТабличнаяЧасть - ОбъектМетаданных, Неопределено - табличная часть
//   * Виртуальная - Булево - Истина для подчиненной таблицы, которая не является табличной частью
//
Функция ОписаниеТаблицы(ИмяТаблицы) Экспорт

	Сегменты = СтрРазделить(ИмяТаблицы, ".");
	Если Сегменты.ВГраница() < 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяОбъекта       = Сегменты[0] + "." + Сегменты[1];
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = Новый Структура("Объект, ОбъектМетаданных", ОбъектМетаданных.ПолноеИмя(), ОбъектМетаданных);
	Описание.Вставить("ТабличнаяЧасть", Неопределено);
	Описание.Вставить("Виртуальная", Ложь);
	ИмяПодчиненнойТаблицы = Сред(ИмяТаблицы, СтрДлина(ИмяОбъекта + ".") + 1);
	Если ИмяПодчиненнойТаблицы = "" Тогда
		Возврат Описание;
	КонецЕсли;

	Коллекции = КоллекцииМетаданных(ОбъектМетаданных);
	Если Коллекции.ТабличныеЧасти <> Неопределено Тогда
		Описание.ТабличнаяЧасть = Коллекции.ТабличныеЧасти.Найти(ИмяПодчиненнойТаблицы);
	КонецЕсли;
	Описание.Виртуальная = Описание.ТабличнаяЧасть = Неопределено;

	Возврат Описание;

КонецФункции

// Находит поле таблицы запроса в метаданных.
//
// Параметры:
//  Таблица - Структура - см. ОписаниеТаблицы
//  ИмяПоля - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если поле не найдено или сопоставляется неоднозначно:
//   * ПолеПравила - Строка - имя поля в правиле обезличивания после полного имени объекта
//   * Тип - ОписаниеТипов
//
Функция ПолеТаблицы(Таблица, ИмяПоля) Экспорт

	Если Таблица.ТабличнаяЧасть <> Неопределено Тогда
		Реквизит = РеквизитМетаданных(Таблица.ТабличнаяЧасть, ИмяПоля);
		Если Реквизит <> Неопределено Тогда
			Возврат Новый Структура("ПолеПравила, Тип", Таблица.ТабличнаяЧасть.Имя + "." + Реквизит.Имя, Реквизит.Тип);
		ИначеЕсли ВРег(ИмяПоля) <> "ССЫЛКА" Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Реквизит = РеквизитМетаданных(Таблица.ОбъектМетаданных, ИмяПоля);
	Если Таблица.Виртуальная Тогда
		Ресурсы = РесурсыВиртуальногоПоля(Таблица.ОбъектМетаданных, ИмяПоля);
		Если Ресурсы.Количество() > 1 ИЛИ (Ресурсы.Количество() = 1 И Реквизит <> Неопределено) Тогда
			Возврат Неопределено;
		ИначеЕсли Ресурсы.Количество() = 1 Тогда
			Реквизит = Ресурсы[0];
		КонецЕсли;
	КонецЕсли;
	Если Реквизит = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("ПолеПравила, Тип", Реквизит.Имя, Реквизит.Тип);

КонецФункции

// Возвращаемое значение:
//  Массив из Строка - классы метаданных, на объекты и поля которых задаются правила обезличивания;
//                     таблицы прочих классов, кроме перечислений, при обезличивании считаются закрытыми
//
Функция КлассыПравил() Экспорт

	Классы = Новый Массив;
	Для Каждого ВидОбъектов Из ВидыОбъектовПравил() Цикл
		Классы.Добавить(ВидОбъектов.Класс);
	КонецЦикла;

	Возврат Классы;

КонецФункции

// Возвращаемое значение:
//  Массив из Строка - классы метаданных, ссылки которых становятся токенами
//
Функция КлассыТокенов() Экспорт

	Возврат СтрРазделить("Справочник,Документ,ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчета,ПланОбмена,"
		+ "БизнесПроцесс,Задача", ",");

КонецФункции

// Возвращает текст ошибки выполнения для агента. При включенном обезличивании полный текст может содержать
// данные базы (например, значение, которое не удалось преобразовать), поэтому агент получает фиксированный
// текст, а полный записывается в журнал регистрации. Вызывается внутри блоков Исключение и сама исключений
// не вызывает.
//
// Параметры:
//  ИсходныйТекст - Строка - полный текст ошибки
//
// Возвращаемое значение:
//  Строка - текст ошибки для агента
//
Функция ТекстОшибкиДляВыдачи(ИсходныйТекст) Экспорт

	Попытка
		Скрыть = Включено();
	Исключение
		// Настройки не прочитаны (например, повреждены) - скрываем: данных лучше не выдать, чем выдать лишнее.
		Скрыть = Истина;
	КонецПопытки;
	Если НЕ Скрыть Тогда
		Возврат ИсходныйТекст;
	КонецЕсли;

	Попытка
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , , ИсходныйТекст);
	Исключение
		// Вызывается внутри блоков Исключение: собственная ошибка не должна заменить фиксированный текст.
	КонецПопытки;

	Возврат НСтр("ru = 'Ошибка при выполнении; текст скрыт, потому что может содержать данные базы.
		|Полный текст - в журнале регистрации (событие ""MCP.Обезличивание"").'");

КонецФункции

// Возвращаемое значение:
//  Строка - имя события журнала регистрации для скрытых ошибок и ошибок обезличивания
//
Функция ИмяСобытияЖурнала() Экспорт

	Возврат НСтр("ru = 'MCP.Обезличивание'", Метаданные.ОсновнойЯзык.КодЯзыка);

КонецФункции

#КонецОбласти

#Область НастройкаОбезличивания

// Возвращает настройки обезличивания для формы настроек. Требует права "Администрирование".
//
// Возвращаемое значение:
//  Структура:
//   * Включено - Булево
//   * Правила - Массив из Строка - полные имена объектов и полей
//   * Повреждены - Булево - Истина, если хранимые настройки повреждены (тогда Включено и Правила - пустые)
//                  или содержат правило, не найденное в метаданных
//   * ПравилаСброшены - Булево - Истина, если хранимые правила старого формата (режим "все, кроме разрешенного")
//                       не перенесены: их смысл противоположный
//
Функция Настройки() Экспорт

	ПроверитьПравоНастройки();

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Хранимые = ХранимыеНастройки(ИмяХраненияНастроек());
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Повреждены = Хранимые = Неопределено;
	Если Повреждены Тогда
		Хранимые = ПустыеНастройки();
	Иначе
		Повреждены = НеверноеПравило(Хранимые.Правила) <> Неопределено;
	КонецЕсли;
	Хранимые.Вставить("Повреждены", Повреждены);

	Возврат Хранимые;

КонецФункции

// Проверяет и записывает настройки обезличивания. Требует права "Администрирование".
// Правила приводятся к каноническим полным именам метаданных, повторы и пустые строки пропускаются;
// если объект или поле какого-либо правила не найдены, ничего не записывается.
// Включенное обезличивание без правил не записывается: закрывать нечего.
// При включении создается ключ токенов и меток, если его еще нет.
//
// Параметры:
//  ОбезличиваниеВключено - Булево
//  Правила - Массив из Строка - полные имена объектов и полей: Справочник.Валюты, Справочник.Контрагенты.ИНН,
//            Документ.Заказ.Товары.Цена, РегистрНакопления.Остатки.Количество
//
Процедура ЗаписатьНастройки(ОбезличиваниеВключено, Правила) Экспорт

	ПроверитьПравоНастройки();

	КаноническиеПравила = Новый Массив;
	Добавленные         = Новый Соответствие;
	Ошибочные           = Новый Массив;
	Для Каждого Правило Из Правила Цикл
		Если ТипЗнч(Правило) <> Тип("Строка") Тогда
			Ошибочные.Добавить(Строка(Правило));
			Продолжить;
		ИначеЕсли ПустаяСтрока(Правило) Тогда
			Продолжить;
		КонецЕсли;
		КаноническоеИмя = КаноническоеПравило(СокрЛП(Правило));
		Если КаноническоеИмя = Неопределено Тогда
			Ошибочные.Добавить(СокрЛП(Правило));
		ИначеЕсли Добавленные.Получить(ВРег(КаноническоеИмя)) = Неопределено Тогда
			Добавленные.Вставить(ВРег(КаноническоеИмя), Истина);
			КаноническиеПравила.Добавить(КаноническоеИмя);
		КонецЕсли;
	КонецЦикла;
	Если Ошибочные.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не найдены объекты, табличные части или поля для правил обезличивания:
			|%1'"), СтрСоединить(Ошибочные, Символы.ПС));
	КонецЕсли;
	// Без правил данные объектов не закрываются: включенный флажок выглядел бы защитой, ничего не защищая
	Если ОбезличиваниеВключено = Истина И КаноническиеПравила.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Обезличивание включено, но правил нет — закрывать нечего.
			|Добавьте правила (""Подобрать правила"" или ""Заполнить"") или снимите флажок обезличивания.'");
	КонецЕсли;

	НовыеНастройки = Новый Структура("Включено, Правила", ОбезличиваниеВключено = Истина, КаноническиеПравила);
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ИмяХранения = ИмяХраненияНастроек();
		Если НовыеНастройки.Включено
			И ХранилищеОбщихНастроек.Загрузить(ИмяХранения, "Ключ", , ИмяХранения) = Неопределено Тогда
			ХранилищеОбщихНастроек.Сохранить(ИмяХранения, "Ключ", НовыйКлюч(), , ИмяХранения);
		КонецЕсли;
		ХранилищеОбщихНастроек.Сохранить(ИмяХранения, "Настройки", НовыеНастройки, , ИмяХранения);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Записывает новый ключ токенов и меток. Токены и метки, выданные со старым ключом, перестают совпадать
// с новыми, а токены из прежних ответов больше не превращаются в ссылки. Требует права "Администрирование".
//
Процедура СменитьКлюч() Экспорт

	ПроверитьПравоНастройки();

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ИмяХранения = ИмяХраненияНастроек();
		ХранилищеОбщихНастроек.Сохранить(ИмяХранения, "Ключ", НовыйКлюч(), , ИмяХранения);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Возвращает записанную настройку инструмента для формы настроек, без кеша. Требует права "Администрирование".
//
// Параметры:
//  ИмяНастройки - Строка - см. НастройкаИнструмента
//  ЗначениеПоУмолчанию - см. НастройкаИнструмента
//
// Возвращаемое значение:
//  Строка, Число, Булево, Дата, Неопределено
//
Функция ХранимаяНастройкаИнструмента(ИмяНастройки, ЗначениеПоУмолчанию = Неопределено) Экспорт

	ПроверитьПравоНастройки();

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Значение = ХранимыеНастройкиИнструментов(ИмяХраненияНастроек()).Получить(ВРег(ИмяНастройки));
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат ?(Значение = Неопределено, ЗначениеПоУмолчанию, Значение);

КонецФункции

// Записывает настройку инструмента. Требует права "Администрирование". Действует в новых сеансах,
// см. НастройкаИнструмента.
//
// Параметры:
//  ИмяНастройки - Строка - см. НастройкаИнструмента
//  Значение - Строка, Число, Булево, Дата
//
Процедура ЗаписатьНастройкуИнструмента(ИмяНастройки, Значение) Экспорт

	ПроверитьПравоНастройки();
	Если ТипЗнч(ИмяНастройки) <> Тип("Строка") ИЛИ ПустаяСтрока(ИмяНастройки)
		ИЛИ НЕ ДопустимоеЗначениеНастройкиИнструмента(Значение) Тогда
		ВызватьИсключение НСтр("ru = 'У настройки инструмента должно быть имя и значение типа строка, число, булево или дата.'");
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ИмяХранения           = ИмяХраненияНастроек();
		НастройкиИнструментов = ХранимыеНастройкиИнструментов(ИмяХранения);
		НастройкиИнструментов.Вставить(ВРег(ИмяНастройки), Значение);
		ХранилищеОбщихНастроек.Сохранить(ИмяХранения, "НастройкиИнструментов", НастройкиИнструментов, , ИмяХранения);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Возвращает объекты метаданных, на которые задаются правила обезличивания, для формы подбора правил.
// Требует права "Администрирование".
//
// Параметры:
//  СтрокаПоиска - Строка - часть имени или синонима объекта или поля без учета регистра и крайних пробелов;
//                 пустая - все объекты
//
// Возвращаемое значение:
//  Массив из Структура - виды объектов, у которых есть подходящие объекты:
//   * Представление - Строка - вид объектов во множественном числе
//   * Объекты - Массив из Структура - см. УзелПодбора; Вложенные объекта - Неопределено, если поля не подобраны:
//               объект подходит под поиск сам или поиск пустой
//   * Картинка - Строка - имя картинки вида объектов в БиблиотекаКартинок
//
Функция ОбъектыПодбораПравил(СтрокаПоиска) Экспорт

	ПроверитьПравоНастройки();

	Искомое   = НРег(СокрЛП(СтрокаПоиска));
	Результат = Новый Массив;
	Для Каждого ВидОбъектов Из ВидыОбъектовПравил() Цикл
		Объекты = Новый Массив;
		Для Каждого ОбъектМетаданных Из Метаданные[ВидОбъектов.Коллекция] Цикл
			Узел = УзелПодбора(ОбъектМетаданных.ПолноеИмя(), ОбъектМетаданных, ВидОбъектов.Класс);
			Если НЕ ПодходитПодПоиск(ОбъектМетаданных, Искомое) Тогда
				Узел.Вложенные = ПоляОбъектаПодбора(ОбъектМетаданных, Искомое);
				Если Узел.Вложенные.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Объекты.Добавить(Узел);
		КонецЦикла;
		Если Объекты.Количество() > 0 Тогда
			Результат.Добавить(Новый Структура("Представление, Объекты, Картинка",
				ВидОбъектов.Представление, Объекты, ВидОбъектов.Класс));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает поля объекта метаданных для формы подбора правил. Требует права "Администрирование".
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных
//
// Возвращаемое значение:
//  Массив из Структура - см. УзелПодбора: реквизиты, стандартные реквизиты, измерения, ресурсы и табличные части
//                        с их реквизитами во Вложенные
//
Функция ПоляПодбораПравил(ПолноеИмяОбъекта) Экспорт

	ПроверитьПравоНастройки();

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат ПоляОбъектаПодбора(ОбъектМетаданных, "");

КонецФункции

// Возвращает правила для типовых мест персональных данных: объекты о людях целиком, регистры сведений
// о физических лицах, контактную информацию, поля по словам имени, наименования контрагентов и партнеров.
// Объектов и полей, которых нет в конфигурации, в результате нет. Требует права "Администрирование".
//
// Возвращаемое значение:
//  Массив из Строка - правила без повторов; полей объектов, закрытых целиком, в нем нет
//
Функция ПравилаПоПризнакамПерсональныхДанных() Экспорт

	ПроверитьПравоНастройки();

	Отбор = НовыйОтборПоПризнакам();
	ДобавитьОбъектыЦеликом(Отбор, ОбъектыСПерсональнымиДанными());
	ДобавитьРегистрыОФизическихЛицах(Отбор);
	ДобавитьПоляПоПризнакам(Отбор, ПризнакиПерсональныхДанных(), Истина);
	ДобавитьПоляКонтрагентов(Отбор);

	Возврат Отбор.Правила;

КонецФункции

// Возвращает правила для полей с паролями, логинами и токенами доступа. Требует права "Администрирование".
//
// Возвращаемое значение:
//  Массив из Строка - правила без повторов
//
Функция ПравилаПоПризнакамСекретов() Экспорт

	ПроверитьПравоНастройки();

	Отбор = НовыйОтборПоПризнакам();
	ДобавитьПоляПоПризнакам(Отбор, ПризнакиСекретов(), Ложь);

	Возврат Отбор.Правила;

КонецФункции

// Возвращает представления правил для формы настроек: синонимы объекта, табличной части и поля.
// Требует права "Администрирование".
//
// Параметры:
//  Правила - Массив из Строка - полные имена объектов и полей
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - правило
//   * Значение - Строка - представление; для правила, не найденного в метаданных, - пустая строка
//
Функция ПредставленияПравил(Правила) Экспорт

	ПроверитьПравоНастройки();

	Разделитель   = " → ";
	Представления = Новый Соответствие;
	Для Каждого Правило Из Правила Цикл
		Если КаноническоеПравило(Правило) <> Правило Тогда
			Представления.Вставить(Правило, "");
			Продолжить;
		КонецЕсли;

		Сегменты = СтрРазделить(Правило, ".");
		Владелец = Метаданные.НайтиПоПолномуИмени(Сегменты[0] + "." + Сегменты[1]);
		Части    = Новый Массив;
		Части.Добавить(ПредставлениеЭлементаМетаданных(Владелец));
		Для Номер = 2 По Сегменты.ВГраница() Цикл
			Элемент = РеквизитМетаданных(Владелец, Сегменты[Номер]);
			Если Элемент = Неопределено Тогда
				Элемент = Владелец.ТабличныеЧасти[Сегменты[Номер]];
			КонецЕсли;
			Части.Добавить(ПредставлениеЭлементаМетаданных(Элемент));
			Владелец = Элемент;
		КонецЦикла;
		Представления.Вставить(Правило, СтрСоединить(Части, Разделитель));
	КонецЦикла;

	Возврат Представления;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Читает настройки обезличивания из хранилища общих настроек. Вызывается из mcp_КонтейнерыПовтИсп,
// который кеширует результат на сеанс. Пока обезличивание выключено, правила, ключ и настройки инструментов
// не читаются.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * Включено - Булево
//   * Правила - ФиксированноеСоответствие из КлючИЗначение:
//      ** Ключ - Строка - полное имя объекта или поля в верхнем регистре
//      ** Значение - Строка - то же имя в каноническом виде, для текста причины
//   * НастройкиИнструментов - ФиксированноеСоответствие из КлючИЗначение - см. НастройкаИнструмента:
//      ** Ключ - Строка - имя настройки в верхнем регистре
//      ** Значение - Строка, Число, Булево, Дата
//   * Ключ - ДвоичныеДанные, Неопределено - ключ токенов и меток; Неопределено, если обезличивание выключено
//
Функция НастройкиСеанса() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Настройки = ПрочитатьНастройкиСеанса();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Настройки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Настройки

Функция ПрочитатьНастройкиСеанса()

	ИмяХранения      = ИмяХраненияНастроек();
	ТекстПовреждения = НСтр("ru = 'Настройки обезличивания повреждены.'");

	Хранимые = ХранимыеНастройки(ИмяХранения);
	Если Хранимые = Неопределено Тогда
		ВызватьИсключение ТекстПовреждения;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Включено", Хранимые.Включено);
	Результат.Вставить("Правила", Новый ФиксированноеСоответствие(Новый Соответствие));
	Результат.Вставить("НастройкиИнструментов", Новый ФиксированноеСоответствие(Новый Соответствие));
	Результат.Вставить("Ключ", Неопределено);
	Если НЕ Хранимые.Включено Тогда
		Возврат Новый ФиксированнаяСтруктура(Результат);
	КонецЕсли;

	ОшибочноеПравило = НеверноеПравило(Хранимые.Правила);
	Если ОшибочноеПравило <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Правило обезличивания ""%1"" не найдено в метаданных.'"),
			ОшибочноеПравило);
	КонецЕсли;

	Правила = Новый Соответствие;
	Для Каждого Правило Из Хранимые.Правила Цикл
		Правила.Вставить(ВРег(Правило), Правило);
	КонецЦикла;
	Результат.Правила               = Новый ФиксированноеСоответствие(Правила);
	Результат.НастройкиИнструментов = Новый ФиксированноеСоответствие(ХранимыеНастройкиИнструментов(ИмяХранения));

	// Ключ создается при записи настроек с включенным обезличиванием. Здесь - на случай, если его все же нет.
	Ключ = ХранилищеОбщихНастроек.Загрузить(ИмяХранения, "Ключ", , ИмяХранения);
	Если Ключ = Неопределено Тогда
		ХранилищеОбщихНастроек.Сохранить(ИмяХранения, "Ключ", НовыйКлюч(), , ИмяХранения);
		Ключ = ХранилищеОбщихНастроек.Загрузить(ИмяХранения, "Ключ", , ИмяХранения);
	КонецЕсли;
	Если ТипЗнч(Ключ) <> Тип("ДвоичныеДанные") ИЛИ Ключ.Размер() <> ДлинаКлюча() Тогда
		ВызватьИсключение ТекстПовреждения;
	КонецЕсли;
	Результат.Ключ = Ключ;

	Возврат Новый ФиксированнаяСтруктура(Результат);

КонецФункции

// Возвращаемое значение:
//  Строка - ключ объекта и служебное имя пользователя настроек обезличивания в хранилище общих настроек;
//           исключение, если в информационной базе есть пользователь с этим именем
//
Функция ИмяХраненияНастроек()

	ИмяХранения = "mcp_Обезличивание";
	Если ПользователиИнформационнойБазы.НайтиПоИмени(ИмяХранения) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Имя пользователя ""%1"" зарезервировано для настроек обезличивания.'"), ИмяХранения);
	КонецЕсли;

	Возврат ИмяХранения;

КонецФункции

// Читает хранимые настройки. Настройки старого формата (с режимом, без признака Включено) приводятся
// к новому: обезличивание выключено; правила режима "только указанное" сохраняются, правила режима
// "все, кроме разрешенного" сбрасываются - их смысл противоположный.
//
// Параметры:
//  ИмяХранения - Строка - см. ИмяХраненияНастроек
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если хранимые настройки повреждены:
//   * Включено - Булево
//   * Правила - Массив из Строка - полные имена объектов и полей
//   * ПравилаСброшены - Булево - Истина, если сброшены правила старого формата
//
Функция ХранимыеНастройки(ИмяХранения)

	Хранимые = ХранилищеОбщихНастроек.Загрузить(ИмяХранения, "Настройки", , ИмяХранения);
	Если Хранимые = Неопределено Тогда
		Возврат ПустыеНастройки();
	КонецЕсли;
	Если ТипЗнч(Хранимые) <> Тип("Структура")
		ИЛИ НЕ Хранимые.Свойство("Правила")
		ИЛИ ТипЗнч(Хранимые.Правила) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Правило Из Хранимые.Правила Цикл
		Если ТипЗнч(Правило) <> Тип("Строка") Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Результат = ПустыеНастройки();
	Если Хранимые.Свойство("Режим") Тогда
		Если Хранимые.Режим = "ПоСписку" Тогда
			Результат.Правила = Хранимые.Правила;
		Иначе
			Результат.ПравилаСброшены = Хранимые.Правила.Количество() > 0;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Если НЕ Хранимые.Свойство("Включено") ИЛИ ТипЗнч(Хранимые.Включено) <> Тип("Булево") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат.Включено = Хранимые.Включено;
	Результат.Правила  = Хранимые.Правила;

	Возврат Результат;

КонецФункции

// Читает хранимые настройки инструментов. Поврежденные настройки и значения недопустимых типов пропускаются:
// инструмент получает значение по умолчанию.
//
// Параметры:
//  ИмяХранения - Строка - см. ИмяХраненияНастроек
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя настройки в верхнем регистре
//   * Значение - Строка, Число, Булево, Дата
//
Функция ХранимыеНастройкиИнструментов(ИмяХранения)

	Результат = Новый Соответствие;
	Хранимые  = ХранилищеОбщихНастроек.Загрузить(ИмяХранения, "НастройкиИнструментов", , ИмяХранения);
	Если ТипЗнч(Хранимые) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Настройка Из Хранимые Цикл
		Если ТипЗнч(Настройка.Ключ) = Тип("Строка") И ДопустимоеЗначениеНастройкиИнструмента(Настройка.Значение) Тогда
			Результат.Вставить(ВРег(Настройка.Ключ), Настройка.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДопустимоеЗначениеНастройкиИнструмента(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Дата");

КонецФункции

// Возвращаемое значение:
//  Структура - см. ХранимыеНастройки
//
Функция ПустыеНастройки()

	Возврат Новый Структура("Включено, Правила, ПравилаСброшены", Ложь, Новый Массив, Ложь);

КонецФункции

// Параметры:
//  Правила - Массив из Строка - хранимые правила обезличивания
//
// Возвращаемое значение:
//  Строка, Неопределено - первое правило, не найденное в метаданных или записанное не в каноническом виде
//
Функция НеверноеПравило(Правила)

	Для Каждого Правило Из Правила Цикл
		Если КаноническоеПравило(Правило) <> Правило Тогда
			Возврат Правило;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ПроверитьПравоНастройки()

	Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для настройки обезличивания данных.'");
	КонецЕсли;

КонецПроцедуры

// Возвращаемое значение:
//  ДвоичныеДанные - случайный ключ токенов и меток длиной ДлинаКлюча
//
Функция НовыйКлюч()

	Случайное = Новый Массив;
	Случайное.Добавить(ДвоичныеДанныеUTF8(Строка(Новый УникальныйИдентификатор)
		+ Строка(Новый УникальныйИдентификатор) + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0")));

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(НачалоХеша(Случайное, ДлинаКлюча()));

КонецФункции

Функция ДлинаКлюча()

	Возврат 32;

КонецФункции

#КонецОбласти

#Область ПодборПравил

// Параметры:
//  ПолноеИмя - Строка - правило
//  ЭлементМетаданных - ОбъектМетаданных, ОписаниеСтандартногоРеквизита
//  Картинка - Строка - имя картинки узла в БиблиотекаКартинок
//
// Возвращаемое значение:
//  Структура:
//   * ПолноеИмя - Строка - правило
//   * Представление - Строка - синоним и имя
//   * Картинка - Строка - имя картинки узла в БиблиотекаКартинок
//   * Вложенные - Массив из Структура, Неопределено - вложенные узлы
//
Функция УзелПодбора(ПолноеИмя, ЭлементМетаданных, Картинка)

	Представление = ПредставлениеЭлементаМетаданных(ЭлементМетаданных);
	Если Представление <> ЭлементМетаданных.Имя Тогда
		Представление = СтрШаблон("%1 (%2)", Представление, ЭлементМетаданных.Имя);
	КонецЕсли;

	Узел = Новый Структура("ПолноеИмя, Представление, Картинка", ПолноеИмя, Представление, Картинка);
	Узел.Вставить("Вложенные", Неопределено);

	Возврат Узел;

КонецФункции

// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект одного из видов ВидыОбъектовПравил
//  Искомое - Строка - см. ПодходитПодПоиск
//
// Возвращаемое значение:
//  Массив из Структура - см. УзелПодбора; табличная часть - узел с правилом на нее целиком и реквизитами во Вложенные
//
Функция ПоляОбъектаПодбора(ОбъектМетаданных, Искомое)

	Поля      = Новый Массив;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Коллекции = КоллекцииМетаданных(ОбъектМетаданных);

	КартинкиКоллекций = Новый Структура;
	КартинкиКоллекций.Вставить("Измерения", "Измерение");
	КартинкиКоллекций.Вставить("Ресурсы", "Ресурс");
	КартинкиКоллекций.Вставить("Реквизиты", "Реквизит");
	КартинкиКоллекций.Вставить("РеквизитыАдресации", "Реквизит");
	КартинкиКоллекций.Вставить("СтандартныеРеквизиты", "Реквизит");
	Для Каждого КартинкаКоллекции Из КартинкиКоллекций Цикл
		Если Коллекции[КартинкаКоллекции.Ключ] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Реквизит Из Коллекции[КартинкаКоллекции.Ключ] Цикл
			Если ПодходитПодПоиск(Реквизит, Искомое) Тогда
				Поля.Добавить(УзелПодбора(ПолноеИмя + "." + Реквизит.Имя, Реквизит, КартинкаКоллекции.Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Коллекции.ТабличныеЧасти = Неопределено Тогда
		Возврат Поля;
	КонецЕсли;
	Для Каждого ТабличнаяЧасть Из Коллекции.ТабличныеЧасти Цикл
		ПоляТабличнойЧасти    = Новый Массив;
		ТабличнаяЧастьНайдена = ПодходитПодПоиск(ТабличнаяЧасть, Искомое);
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			Если ТабличнаяЧастьНайдена ИЛИ ПодходитПодПоиск(Реквизит, Искомое) Тогда
				ПоляТабличнойЧасти.Добавить(
					УзелПодбора(ПолноеИмя + "." + ТабличнаяЧасть.Имя + "." + Реквизит.Имя, Реквизит, "Реквизит"));
			КонецЕсли;
		КонецЦикла;
		Если ПоляТабличнойЧасти.Количество() > 0 Тогда
			Узел = УзелПодбора(ПолноеИмя + "." + ТабличнаяЧасть.Имя, ТабличнаяЧасть, "ВложеннаяТаблица");
			Узел.Вложенные = ПоляТабличнойЧасти;
			Поля.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;

	Возврат Поля;

КонецФункции

// Параметры:
//  ЭлементМетаданных - ОбъектМетаданных, ОписаниеСтандартногоРеквизита
//  Искомое - Строка - строка поиска в нижнем регистре без крайних пробелов
//
// Возвращаемое значение:
//  Булево - Истина, если искомое пустое или входит в имя или синоним
//
Функция ПодходитПодПоиск(ЭлементМетаданных, Искомое)

	Возврат Искомое = ""
		ИЛИ СтрНайти(НРег(ЭлементМетаданных.Имя), Искомое) > 0
		ИЛИ СтрНайти(НРег(ЭлементМетаданных.Синоним), Искомое) > 0;

КонецФункции

// Параметры:
//  ЭлементМетаданных - ОбъектМетаданных, ОписаниеСтандартногоРеквизита
//
// Возвращаемое значение:
//  Строка - синоним, а без синонима - имя
//
Функция ПредставлениеЭлементаМетаданных(ЭлементМетаданных)

	Если ЗначениеЗаполнено(ЭлементМетаданных.Синоним) Тогда
		Возврат ЭлементМетаданных.Синоним;
	КонецЕсли;

	Возврат ЭлементМетаданных.Имя;

КонецФункции

#КонецОбласти

#Область ПризнакиПравил

// Автозаполнение правил по признакам. Имя поля делится на слова (см. СловаИмени), признак - одно или несколько
// слов подряд: так «Адрес» не находится в «Переадресовка», а «Имя» - в «ИмяФайла». Признаки и списки объектов -
// данными в функциях ОбъектыСПерсональнымиДанными, ПризнакиПерсональныхДанных, ПризнакиСекретов.

// Возвращаемое значение:
//  Структура:
//   * Правила - Массив из Строка - найденные правила в порядке добавления
//   * Добавленные - Соответствие - правила, уже добавленные в Правила
//   * ОбъектыЦеликом - Соответствие - полные имена объектов, закрытых целиком: их поля не добавляются
//   * КлючиИмен - Соответствие - ключи слов по именам, см. КлючИмени
//
Функция НовыйОтборПоПризнакам()

	Отбор = Новый Структура;
	Отбор.Вставить("Правила", Новый Массив);
	Отбор.Вставить("Добавленные", Новый Соответствие);
	Отбор.Вставить("ОбъектыЦеликом", Новый Соответствие);
	Отбор.Вставить("КлючиИмен", Новый Соответствие);

	Возврат Отбор;

КонецФункции

// Возвращаемое значение:
//  Массив из Строка - полные имена объектов о людях; имя со звездочкой в конце - все объекты класса,
//                     имя которых начинается с указанного
//
Функция ОбъектыСПерсональнымиДанными()

	Имена = Новый Массив;
	// Люди
	ДобавитьИмена(Имена, "Справочник", "ФизическиеЛица,КонтактныеЛица,КонтактныеЛицаПартнеров,Пользователи,"
		+ "ВнешниеПользователи,Сотрудники,СотрудникиОрганизаций,РодственникиФизическихЛиц,ОбразованиеФизическихЛиц,"
		+ "СправкиФизическихЛиц,Individuals,ContactPersons,Users,ExternalUsers,Employees");
	// Карты, лиды, подписи и доверенности
	ДобавитьИмена(Имена, "Справочник", "БанковскиеКартыКонтрагентов,ДисконтныеКарты,ИнформационныеКарты,"
		+ "Лиды,КонтактыЛидов,CRM_ПотенциальныеКлиенты,Leads,СертификатыКлючейЭлектроннойПодписиИШифрования,"
		+ "ПодписантыОрганизацийЕИС,ПодписантыСервисаМобильнойПодписи,ДоверенностиНалогоплательщика,"
		+ "МашиночитаемыеДоверенности*,CRM_Диалоги");
	// Документы о персональных данных, переписка и звонки
	ДобавитьИмена(Имена, "Документ", "СогласиеНаОбработкуПерсональныхДанных,"
		+ "ОтзывСогласияНаОбработкуПерсональныхДанных,АктОбУничтоженииПерсональныхДанных,Анкета,"
		+ "ЭлектронноеПисьмоВходящее,ЭлектронноеПисьмоИсходящее,ЭлектронноеПисьмо,ТелефонныйЗвонок,СообщениеSMS,"
		+ "Встреча,ЗапланированноеВзаимодействие,CRM_СообщениеМессенджера,IncomingEmail,OutgoingEmail,SMSMessage");
	// Регистры сведений о людях, которых не находит признак ДобавитьРегистрыОФизическихЛицах
	ДобавитьИмена(Имена, "РегистрСведений", "ВоинскийУчет,СведенияОбЭЛН,ЗастрахованныеЛицаСЭДО,"
		+ "СНИЛСВходящихСообщенийСЭДО,ЛицевыеСчетаСотрудниковПоЗарплатнымПроектам,"
		+ "МашиночитаемыеДоверенностиПредставителиИДоверители,ПодключенныеМПЭПД,СведенияОПользователях,"
		+ "ИдентификационныеДанныеПользователей,ДанныеЗвонков,КонтактЦентрВходящее,ОтказалисьОтРассылки,"
		+ "ОчередьРассылок,ДанныеНезарегистрированныхКонтрагентов,СМССообщения,ChangeHistoryOfIndividualNames");
	// Регистры CRM: телефония (номер телефона в измерении, полем его не закрыть), поиск контактов, переписка
	ДобавитьИмена(Имена, "РегистрСведений", "сфпЗаписиТелефонныхПереговоров,сфпИсторияЗвонков,сфпТекущиеЗвонки,"
		+ "сфпНомераТелефоновДляПоиска,сфпДанныеКоллтрекинга,сфпНеобрабатываемыеТелефонныеНомера,"
		+ "сфпРеестрНецелевыхНомеров,CRM_ДанныеДляПоискаКонтактов,CRM_ИзменениеКонтактнойИнформации,"
		+ "CRM_ДоверенныеАдресаЭлектроннойПочты,CRM_ЖурналПосещений,CRM_ДанныеАвтосохранения");

	Возврат Имена;

КонецФункции

// Признаки полей с персональными данными. Тип поля - строка, если у признака не указано иное.
//
// Возвращаемое значение:
//  см. НовыеПризнаки
//
Функция ПризнакиПерсональныхДанных()

	Признаки = НовыеПризнаки("Сервер,Сервера,Сервиса,Сайта,Приложения,Авторизации,Маска,Маски,Файла,"
		+ "Соответствия,Организации,Банка,Шаблон,Шаблона,Устройства,Каталог,Server,Service,Mask,File,Template");

	ТипыПола = "Строка";
	Для Каждого ИмяПеречисления Из СтрРазделить("ПолФизическогоЛица,Gender", ",") Цикл
		Если Метаданные.Перечисления.Найти(ИмяПеречисления) <> Неопределено Тогда
			ТипыПола = ТипыПола + ",ПеречислениеСсылка." + ИмяПеречисления;
		КонецЕсли;
	КонецЦикла;

	// ФИО; «Имя» - только рядом с такой же «Фамилией» (CRM_Имя - CRM_Фамилия)
	ДобавитьПризнак(Признаки, "Фамилия,Фамилии,Отчество,Отчества,ФИО,Инициалы,"
		+ "FirstName,LastName,MiddleName,Surname,Patronymic");
	ДобавитьПризнак(Признаки, "Имя", , , , "ПарнаяФамилия");
	// Рождение, пол, фото
	ДобавитьПризнак(Признаки, "ДатаРождения,МестоРождения,Birthdate,DateOfBirth,BirthPlace", , "Строка,Дата");
	ДобавитьПризнак(Признаки, "Пол,Gender", , ТипыПола);
	ДобавитьПризнак(Признаки, "Фото,Фотография,Photo", , "ХранилищеЗначения");
	// Телефон и почта
	ДобавитьПризнак(Признаки, "Телефон,Телефоны,Телефона,Phone,ЭлектроннаяПочта,ЭлектроннойПочты,АдресЭП,"
		+ "EMAddress");
	ДобавитьПризнак(Признаки, "Email,EMail", , , "Конец");
	// Адрес человека; просто «Адрес» - в таблице с фамилией или в табличной части получателей и участников
	ДобавитьПризнак(Признаки, "Адрес", "Регистрации,Проживания,Жительства,Пребывания,Фактический,Доставки,"
		+ "Клиента,Покупателя,Получателя,Субъекта");
	ДобавитьПризнак(Признаки, "Address", "Shipping,Delivery,Home");
	ДобавитьПризнак(Признаки, "Адрес,Address", , , "Целиком", "ТаблицаЛюдей");
	// Документ, удостоверяющий личность
	ДобавитьПризнак(Признаки, "Паспорт,ПаспортныеДанные,УдостоверяющийЛичность,УдостоверяющегоЛичность,"
		+ "УдЛичности,УдостоверениеЛичности,КемВыдан,Passport,IdentityNumber,IdentificationNumber");
	ДобавитьПризнак(Признаки, "Удостоверение", "Серия,Номер");
	ДобавитьПризнак(Признаки, "Серия,Номер,ДатаВыдачи", "Покупателя,ФизЛица,Физлица");
	// Номера человека
	ДобавитьПризнак(Признаки, "СНИЛС,СтраховойНомер,ИННФЛ");
	ДобавитьПризнак(Признаки, "ИНН", "ФЛ,ФизЛица,Физлица,Сотрудник,Сотрудника,Представитель,Представителя,"
		+ "Покупатель,Покупателя,Кассир");
	// Счета и карты
	ДобавитьПризнак(Признаки, "НомерЛицевогоСчета,БанковскойКарты,ПлатежнойКарты,ДержателяКарты");
	ДобавитьПризнак(Признаки, "ЛицевойСчет", , , "Целиком");
	// Люди строкой в учетных документах: ссылки на них станут токенами, а эти строки - нет
	ДобавитьПризнак(Признаки, "Выдать,ПринятоОт,ПоДокументу,НаПолучениеОт,ТекстПолучателя,ТекстПлательщика,"
		+ "РасшифровкаПодписи,КомуВыдан,КакСвязаться,НомерДляОтправки,Водитель,ВодительскоеУдостоверение,"
		+ "КонтактноеЛицо");
	ДобавитьПризнак(Признаки, "Строкой", "Исполнители,Контакт,Телефон,Партнер,Сотрудник,Сотрудников,Участники,"
		+ "Участников,Получатели,Лицо,Покупатель", , "Конец");

	Возврат Признаки;

КонецФункции

// Возвращаемое значение:
//  см. НовыеПризнаки
//
Функция ПризнакиСекретов()

	Признаки = НовыеПризнаки();
	ДобавитьПризнак(Признаки, "Пароль,Логин,Токен,ИмяПользователя,Password,Login,Token");

	Возврат Признаки;

КонецФункции

// Параметры:
//  СтопСлова - Строка - через запятую слова, с которыми поле не подходит ни под один признак
//
// Возвращаемое значение:
//  Структура:
//   * ПоПервомуСлову - Соответствие из КлючИЗначение - признаки по первому слову: поле проверяется только
//                      на признаки, которые начинаются с одного из его слов:
//      ** Ключ - Строка - слово в верхнем регистре
//      ** Значение - Массив из Структура - см. ДобавитьПризнак
//   * СтопСлова - Соответствие - слова в верхнем регистре
//   * СловаФамилии - Массив из Строка - ключи слов поля с фамилией, см. ПризнакСовпадает
//   * СловаПолучателей - Массив из Строка - ключи слов табличной части получателей и участников
//
Функция НовыеПризнаки(СтопСлова = "")

	Признаки = Новый Структура;
	Признаки.Вставить("ПоПервомуСлову", Новый Соответствие);
	Признаки.Вставить("СтопСлова", Новый Соответствие);
	Для Каждого Слово Из СтрРазделить(ВРег(СтопСлова), ",", Ложь) Цикл
		Признаки.СтопСлова.Вставить(СокрЛП(Слово), Истина);
	КонецЦикла;
	Признаки.Вставить("СловаФамилии", КлючиСлов("Фамилия,Surname,LastName"));
	Признаки.Вставить("СловаПолучателей", КлючиСлов("Получатели,Участники,Адресаты,Recipients"));

	Возврат Признаки;

КонецФункции

// Параметры:
//  Признаки - см. НовыеПризнаки
//  Слова - Строка - признаки через запятую; признак - одно или несколько слов подряд в виде имени («ДатаРождения»)
//  ОдноИз - Строка - через запятую слова, одно из которых тоже должно быть в имени; пустая - без условия
//  Типы - Строка - через запятую имена типов; поле подходит, если в его типе есть хотя бы один
//  Место - Строка - "" - слова где угодно в имени, "Конец" - в конце, "Целиком" - имя состоит из этих слов
//  Условие - Строка - "", "ПарнаяФамилия" или "ТаблицаЛюдей", см. ПризнакСовпадает
//
Процедура ДобавитьПризнак(Признаки, Слова, ОдноИз = "", Типы = "Строка", Место = "", Условие = "")

	ТипыПризнака = Новый Массив;
	Для Каждого ИмяТипа Из СтрРазделить(Типы, ",") Цикл
		ТипыПризнака.Добавить(Тип(ИмяТипа));
	КонецЦикла;

	КлючиОдноИз = КлючиСлов(ОдноИз);
	Для Каждого КлючПризнака Из КлючиСлов(Слова) Цикл
		ПервоеСлово = СтрРазделить(КлючПризнака, "|", Ложь)[0];
		СПервымСловом = Признаки.ПоПервомуСлову[ПервоеСлово];
		Если СПервымСловом = Неопределено Тогда
			СПервымСловом = Новый Массив;
			Признаки.ПоПервомуСлову.Вставить(ПервоеСлово, СПервымСловом);
		КонецЕсли;
		СПервымСловом.Добавить(Новый Структура("Слова, ОдноИз, Типы, Место, Условие",
			КлючПризнака, КлючиОдноИз, ТипыПризнака, Место, Условие));
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Имена - Массив из Строка - дополняемый список полных имен
//  Класс - Строка - первый сегмент полного имени
//  ИменаОбъектов - Строка - имена объектов через запятую
//
Процедура ДобавитьИмена(Имена, Класс, ИменаОбъектов)

	Для Каждого ИмяОбъекта Из СтрРазделить(ИменаОбъектов, ",", Ложь) Цикл
		Имена.Добавить(Класс + "." + СокрЛП(ИмяОбъекта));
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Отбор - см. НовыйОтборПоПризнакам
//  Имена - см. ОбъектыСПерсональнымиДанными
//
Процедура ДобавитьОбъектыЦеликом(Отбор, Имена)

	Коллекции = Новый Соответствие;
	Для Каждого ВидОбъектов Из ВидыОбъектовПравил() Цикл
		Коллекции.Вставить(ВидОбъектов.Класс, ВидОбъектов.Коллекция);
	КонецЦикла;

	Для Каждого Имя Из Имена Цикл
		Если НЕ СтрЗаканчиваетсяНа(Имя, "*") Тогда
			ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Имя);
			Если ОбъектМетаданных <> Неопределено Тогда
				ДобавитьОбъектЦеликом(Отбор, ОбъектМетаданных);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Сегменты = СтрРазделить(Лев(Имя, СтрДлина(Имя) - 1), ".");
		Для Каждого ОбъектМетаданных Из Метаданные[Коллекции[Сегменты[0]]] Цикл
			Если СтрНачинаетсяС(ВРег(ОбъектМетаданных.Имя), ВРег(Сегменты[1])) Тогда
				ДобавитьОбъектЦеликом(Отбор, ОбъектМетаданных);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Добавляет регистры сведений, в имени которых есть «ФизическихЛиц» или «ФизЛиц» и есть измерение со ссылкой
// на физическое лицо или сотрудника: так находятся регистры и БСП, и старых конфигураций, а классификаторы
// (ВидыДокументовФизическихЛиц) - нет.
//
// Параметры:
//  Отбор - см. НовыйОтборПоПризнакам
//
Процедура ДобавитьРегистрыОФизическихЛицах(Отбор)

	ТипыЛюдей = Новый Массив;
	Для Каждого ИмяСправочника Из СтрРазделить("ФизическиеЛица,Сотрудники,СотрудникиОрганизаций,Individuals,"
		+ "Employees", ",") Цикл
		Если Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено Тогда
			ТипыЛюдей.Добавить(Тип("СправочникСсылка." + ИмяСправочника));
		КонецЕсли;
	КонецЦикла;

	СловаРегистров = КлючиСлов("ФизическихЛиц,ФизЛиц,Физлиц");
	Для Каждого Регистр Из Метаданные.РегистрыСведений Цикл
		Если НЕ СодержитОдноИз(КлючИмени(Отбор, Регистр.Имя), СловаРегистров) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Измерение Из Регистр.Измерения Цикл
			Если СодержитТипИз(Измерение.Тип, ТипыЛюдей) Тогда
				ДобавитьОбъектЦеликом(Отбор, Регистр);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Добавляет поля, подходящие под признаки, во всех объектах и табличных частях, кроме объектов, закрытых целиком.
//
// Параметры:
//  Отбор - см. НовыйОтборПоПризнакам
//  Признаки - см. НовыеПризнаки
//  КонтактнаяИнформация - Булево - закрывать табличные части контактной информации целиком, а у регистра
//                         сведений контактной информации - все строковые поля
//
Процедура ДобавитьПоляПоПризнакам(Отбор, Признаки, КонтактнаяИнформация)

	Для Каждого ВидОбъектов Из ВидыОбъектовПравил() Цикл
		Для Каждого ОбъектМетаданных Из Метаданные[ВидОбъектов.Коллекция] Цикл
			ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
			Если Отбор.ОбъектыЦеликом[ПолноеИмя] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Коллекции = КоллекцииМетаданных(ОбъектМетаданных);
			Поля = Новый Массив;
			Для Каждого ИмяКоллекции Из СтрРазделить("Измерения,Ресурсы,Реквизиты,РеквизитыАдресации", ",") Цикл
				Если Коллекции[ИмяКоллекции] <> Неопределено Тогда
					Для Каждого Поле Из Коллекции[ИмяКоллекции] Цикл
						Поля.Добавить(Поле);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			ВсеСтроковые = КонтактнаяИнформация И ВидОбъектов.Класс = "РегистрСведений"
				И ЭтоТаблицаКонтактнойИнформации(ОбъектМетаданных.Имя);
			ДобавитьПоляТаблицы(Отбор, ПолноеИмя + ".", "", Поля, Признаки, ВсеСтроковые);

			Если Коллекции.ТабличныеЧасти = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ТабличнаяЧасть Из Коллекции.ТабличныеЧасти Цикл
				ИмяТабличнойЧасти = ТабличнаяЧасть.Имя;
				// Табличная часть контактной информации - одним правилом: закроются и поля, добавленные позже
				Если КонтактнаяИнформация И ЭтоТаблицаКонтактнойИнформации(ИмяТабличнойЧасти) Тогда
					ДобавитьПравилоОтбора(Отбор, ПолноеИмя + "." + ИмяТабличнойЧасти);
					Продолжить;
				КонецЕсли;
				ДобавитьПоляТаблицы(Отбор, ПолноеИмя + "." + ИмяТабличнойЧасти + ".", ИмяТабличнойЧасти,
					ТабличнаяЧасть.Реквизиты, Признаки, Ложь);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Отбор - см. НовыйОтборПоПризнакам
//  Префикс - Строка - полное имя таблицы с точкой в конце
//  ИмяТабличнойЧасти - Строка - для полей самого объекта - пустая строка
//  Поля - Массив из ОбъектМетаданных, КоллекцияОбъектовМетаданных - поля таблицы
//  Признаки - см. НовыеПризнаки
//  ВсеСтроковые - Булево - добавить все строковые поля
//
Процедура ДобавитьПоляТаблицы(Отбор, Префикс, ИмяТабличнойЧасти, Поля, Признаки, ВсеСтроковые)

	Таблица   = Новый Структура("Ключи, ЕстьФамилия", Новый Соответствие, Ложь);
	ИменаПолей = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		ИмяПоля = Поле.Имя;
		ИменаПолей.Добавить(ИмяПоля);
		Ключ = КлючИмени(Отбор, ИмяПоля);
		Таблица.Ключи.Вставить(Ключ, Истина);
		Таблица.ЕстьФамилия = Таблица.ЕстьФамилия ИЛИ СодержитОдноИз(Ключ, Признаки.СловаФамилии);
	КонецЦикла;
	Таблица.Вставить("Получатели", СодержитОдноИз(КлючИмени(Отбор, ИмяТабличнойЧасти), Признаки.СловаПолучателей));

	Номер = 0;
	Для Каждого Поле Из Поля Цикл
		ИмяПоля = ИменаПолей[Номер];
		Номер = Номер + 1;
		Если ВсеСтроковые И Поле.Тип.СодержитТип(Тип("Строка"))
			ИЛИ ПолеПодходитПодПризнаки(Поле, КлючИмени(Отбор, ИмяПоля), Признаки, Таблица) Тогда
			ДобавитьПравилоОтбора(Отбор, Префикс + ИмяПоля);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Поле - ОбъектМетаданных
//  Ключ - Строка - см. КлючСлов
//  Признаки - см. НовыеПризнаки
//  Таблица - Структура - поля таблицы, в которой поле:
//   * Ключи - Соответствие - ключи слов всех полей таблицы
//   * ЕстьФамилия - Булево - в таблице есть поле со словом «Фамилия»
//   * Получатели - Булево - табличная часть получателей или участников
//
// Возвращаемое значение:
//  Булево
//
Функция ПолеПодходитПодПризнаки(Поле, Ключ, Признаки, Таблица)

	Слова = СтрРазделить(Ключ, "|", Ложь);
	Для Каждого Слово Из Слова Цикл
		Если Признаки.СтопСлова[Слово] <> Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Слово Из Слова Цикл
		СПервымСловом = Признаки.ПоПервомуСлову[Слово];
		Если СПервымСловом = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Признак Из СПервымСловом Цикл
			Если ПризнакСовпадает(Признак, Поле, Ключ, Таблица) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Параметры:
//  Признак - Структура - см. ДобавитьПризнак
//  Поле - ОбъектМетаданных
//  Ключ - Строка - см. КлючСлов
//  Таблица - см. ПолеПодходитПодПризнаки
//
// Возвращаемое значение:
//  Булево
//
Функция ПризнакСовпадает(Признак, Поле, Ключ, Таблица)

	Если Признак.Место = "Целиком" Тогда
		Совпадает = (Ключ = Признак.Слова);
	ИначеЕсли Признак.Место = "Конец" Тогда
		Совпадает = СтрЗаканчиваетсяНа(Ключ, Признак.Слова);
	Иначе
		Совпадает = СтрНайти(Ключ, Признак.Слова) > 0;
	КонецЕсли;

	Если НЕ Совпадает
		ИЛИ НЕ СодержитТипИз(Поле.Тип, Признак.Типы)
		ИЛИ (Признак.ОдноИз.Количество() > 0 И НЕ СодержитОдноИз(Ключ, Признак.ОдноИз)) Тогда
		Возврат Ложь;
	ИначеЕсли Признак.Условие = "ПарнаяФамилия" Тогда
		// В той же таблице есть поле, где вместо этих слов «Фамилия»: CRM_Имя - CRM_Фамилия,
		// ИмяЛатиницей - ФамилияЛатиницей; у ИмяФайла пары нет
		Возврат Таблица.Ключи[СтрЗаменить(Ключ, Признак.Слова, "|ФАМИЛИЯ|")] <> Неопределено;
	ИначеЕсли Признак.Условие = "ТаблицаЛюдей" Тогда
		Возврат Таблица.ЕстьФамилия ИЛИ Таблица.Получатели;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Наименование и ИНН контрагентов и партнеров: частное лицо от организации по метаданным не отличить.
// Если клиенты - организации, администратор удаляет эти правила.
//
// Параметры:
//  Отбор - см. НовыйОтборПоПризнакам
//
Процедура ДобавитьПоляКонтрагентов(Отбор)

	ПоляОбъектов = Новый Массив;
	ПоляОбъектов.Добавить(Новый Структура("Объект, Поля", "Справочник.Контрагенты",
		"Наименование,НаименованиеПолное,ИНН"));
	ПоляОбъектов.Добавить(Новый Структура("Объект, Поля", "Справочник.Партнеры", "Наименование,НаименованиеПолное"));
	ПоляОбъектов.Добавить(Новый Структура("Объект, Поля", "Справочник.Counterparties", "Description,DescriptionFull,TIN"));

	Для Каждого ПоляОбъекта Из ПоляОбъектов Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПоляОбъекта.Объект);
		Если ОбъектМетаданных = Неопределено
			ИЛИ Отбор.ОбъектыЦеликом[ОбъектМетаданных.ПолноеИмя()] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИмяПоля Из СтрРазделить(ПоляОбъекта.Поля, ",") Цикл
			Реквизит = РеквизитМетаданных(ОбъектМетаданных, ИмяПоля);
			Если Реквизит <> Неопределено Тогда
				ДобавитьПравилоОтбора(Отбор, ОбъектМетаданных.ПолноеИмя() + "." + Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьОбъектЦеликом(Отбор, ОбъектМетаданных)

	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	ДобавитьПравилоОтбора(Отбор, ПолноеИмя);
	Отбор.ОбъектыЦеликом.Вставить(ПолноеИмя, Истина);

КонецПроцедуры

Процедура ДобавитьПравилоОтбора(Отбор, Правило)

	Если Отбор.Добавленные[Правило] = Неопределено Тогда
		Отбор.Правила.Добавить(Правило);
		Отбор.Добавленные.Вставить(Правило, Истина);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоТаблицаКонтактнойИнформации(Имя)

	Возврат СтрРазделить("КОНТАКТНАЯИНФОРМАЦИЯ,ИСТОРИЯКОНТАКТНОЙИНФОРМАЦИИ,CONTACTINFORMATION", ",")
		.Найти(ВРег(Имя)) <> Неопределено;

КонецФункции

// Параметры:
//  ТипПоля - ОписаниеТипов
//  Типы - Массив из Тип
//
// Возвращаемое значение:
//  Булево - в типе поля есть хотя бы один из типов
//
Функция СодержитТипИз(ТипПоля, Типы)

	Для Каждого ТипЗначения Из Типы Цикл
		Если ТипПоля.СодержитТип(ТипЗначения) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Параметры:
//  Ключ - Строка - см. КлючСлов
//  Ключи - Массив из Строка - ключи слов, см. КлючСлов
//
// Возвращаемое значение:
//  Булево - в ключе есть хотя бы одна из последовательностей слов
//
Функция СодержитОдноИз(Ключ, Ключи)

	Для Каждого Искомое Из Ключи Цикл
		Если СтрНайти(Ключ, Искомое) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Параметры:
//  Отбор - см. НовыйОтборПоПризнакам
//  Имя - Строка
//
// Возвращаемое значение:
//  Строка - см. КлючСлов; запоминается в отборе: одинаковые имена полей встречаются сотнями
//
Функция КлючИмени(Отбор, Имя)

	Ключ = Отбор.КлючиИмен[Имя];
	Если Ключ = Неопределено Тогда
		Ключ = КлючСлов(Имя);
		Отбор.КлючиИмен.Вставить(Имя, Ключ);
	КонецЕсли;

	Возврат Ключ;

КонецФункции

// Параметры:
//  Имена - Строка - имена через запятую
//
// Возвращаемое значение:
//  Массив из Строка - см. КлючСлов
//
Функция КлючиСлов(Имена)

	Ключи = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Ключи.Добавить(КлючСлов(СокрЛП(Имя)));
	КонецЦикла;

	Возврат Ключи;

КонецФункции

// Параметры:
//  Имя - Строка
//
// Возвращаемое значение:
//  Строка - слова имени в верхнем регистре, каждое между «|»: ИмяФайлаПодписи - |ИМЯ|ФАЙЛА|ПОДПИСИ|;
//           последовательность слов ищется в ключе поиском подстроки
//
Функция КлючСлов(Имя)

	Возврат "|" + ВРег(СтрСоединить(СловаИмени(Имя), "|")) + "|";

КонецФункции

// Делит имя на слова: по «_», перед заглавной буквой после строчной, перед последней заглавной из ряда заглавных,
// если за ней строчная (СНИЛССотрудника - СНИЛС, Сотрудника), и на границе цифр.
//
// Параметры:
//  Имя - Строка
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция СловаИмени(Имя)

	Слова = Новый Массив;
	Слово = "";
	Для Номер = 1 По СтрДлина(Имя) Цикл
		Символ = Сред(Имя, Номер, 1);
		Если Символ = "_" Тогда
			Если Слово <> "" Тогда
				Слова.Добавить(Слово);
			КонецЕсли;
			Слово = "";
			Продолжить;
		КонецЕсли;
		Если Слово <> "" И НачинаетсяСлово(Сред(Имя, Номер - 1, 1), Символ, Сред(Имя, Номер + 1, 1)) Тогда
			Слова.Добавить(Слово);
			Слово = "";
		КонецЕсли;
		Слово = Слово + Символ;
	КонецЦикла;
	Если Слово <> "" Тогда
		Слова.Добавить(Слово);
	КонецЕсли;

	Возврат Слова;

КонецФункции

Функция НачинаетсяСлово(Предыдущий, Текущий, Следующий)

	Цифры = "0123456789";
	Если (СтрНайти(Цифры, Предыдущий) > 0) <> (СтрНайти(Цифры, Текущий) > 0) Тогда
		Возврат Истина;
	КонецЕсли;

	ТекущийЗаглавный    = Текущий <> НРег(Текущий);
	ПредыдущийСтрочный  = Предыдущий <> ВРег(Предыдущий);
	ПредыдущийЗаглавный = Предыдущий <> НРег(Предыдущий);
	СледующийСтрочный   = Следующий <> ВРег(Следующий);

	Возврат ТекущийЗаглавный И (ПредыдущийСтрочный ИЛИ ПредыдущийЗаглавный И СледующийСтрочный);

КонецФункции

#КонецОбласти

#Область Метаданные

// Параметры:
//  Правило - Строка - полное имя объекта, табличной части или поля; регистр имен любой, класс - на русском
//            или английском
//
// Возвращаемое значение:
//  Строка, Неопределено - полное имя в том виде, в каком его сравнивает ПолеЗакрыто (поле - как
//                         в ПолеТаблицы); Неопределено, если объект, табличная часть или поле не найдены
//
Функция КаноническоеПравило(Правило)

	СегментовИмениОбъекта    = 2;
	НаибольшееЧислоСегментов = 4;

	Сегменты       = СтрРазделить(Правило, ".");
	ЭтоПравилоПоля = Сегменты.Количество() > СегментовИмениОбъекта;
	Если Сегменты.Количество() < СегментовИмениОбъекта ИЛИ Сегменты.Количество() > НаибольшееЧислоСегментов Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяПоля = "";
	Если ЭтоПравилоПоля Тогда
		ИмяПоля = Сегменты[Сегменты.ВГраница()];
		Сегменты.Удалить(Сегменты.ВГраница());
	КонецЕсли;

	Таблица = ОписаниеТаблицы(СтрСоединить(Сегменты, "."));
	Если Таблица = Неопределено
		ИЛИ Таблица.Виртуальная
		ИЛИ КлассыПравил().Найти(СтрРазделить(Таблица.Объект, ".")[0]) = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли НЕ ЭтоПравилоПоля Тогда
		Возврат Таблица.Объект;
	КонецЕсли;

	Поле = ПолеТаблицы(Таблица, ИмяПоля);
	Если Поле <> Неопределено Тогда
		Возврат Таблица.Объект + "." + Поле.ПолеПравила;
	ИначеЕсли Таблица.ТабличнаяЧасть <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Табличная часть целиком: закрывает все свои поля (ПолеЗакрыто проверяет и правила на то, что содержит поле)
	ТабличныеЧасти = КоллекцииМетаданных(Таблица.ОбъектМетаданных).ТабличныеЧасти;
	ТабличнаяЧасть = ?(ТабличныеЧасти = Неопределено, Неопределено, ТабличныеЧасти.Найти(ИмяПоля));
	Если ТабличнаяЧасть = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Таблица.Объект + "." + ТабличнаяЧасть.Имя;

КонецФункции

// Добавляет полные имена объектов и полей в том виде, в каком они записываются в правилах, в верхнем регистре.
//
// Параметры:
//  Объекты - см. ПравилаОбъектов
//  Имена - Массив из Строка - дополняется
//
Процедура ДобавитьИменаВПравилах(Объекты, Имена)

	ТипОбъектов = ТипЗнч(Объекты);
	Если ТипОбъектов = Тип("Массив") ИЛИ ТипОбъектов = Тип("ФиксированныйМассив") Тогда
		Для Каждого Элемент Из Объекты Цикл
			ДобавитьИменаВПравилах(Элемент, Имена);
		КонецЦикла;
	ИначеЕсли ТипОбъектов = Тип("ОписаниеТипов") Тогда
		Для Каждого ТипЭлемента Из Объекты.Типы() Цикл
			ДобавитьИменаВПравилах(ТипЭлемента, Имена);
		КонецЦикла;
	ИначеЕсли ТипОбъектов = Тип("Тип") Тогда
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Объекты);
		Если ОбъектМетаданных <> Неопределено Тогда
			ДобавитьИменаВПравилах(ОбъектМетаданных, Имена);
		КонецЕсли;
	ИначеЕсли ТипОбъектов = Тип("ОбъектМетаданных") Тогда
		// Полное имя поля: <Класс>.<Объект>.<Коллекция>.<Поле> или <Класс>.<Объект>.ТабличнаяЧасть.<Таблица>.
		// <Коллекция>.<Поле>; в правиле имен коллекций нет
		Сегменты = СтрРазделить(Объекты.ПолноеИмя(), ".");
		Если Сегменты.Количество() < 2 Тогда
			Возврат;
		КонецЕсли;
		Имя   = Сегменты[0] + "." + Сегменты[1];
		Номер = 3;
		Пока Номер <= Сегменты.ВГраница() Цикл
			Имя   = Имя + "." + Сегменты[Номер];
			Номер = Номер + 2;
		КонецЦикла;
		Имена.Добавить(ВРег(Имя));
	ИначеЕсли ТипОбъектов = Тип("Строка") И НЕ ПустаяСтрока(Объекты) Тогда
		Имена.Добавить(ВРег(СокрЛП(Объекты)));
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Правила - ФиксированноеСоответствие - см. НастройкиСеанса
//  Ключ - Строка - правило в верхнем регистре
//  Результат - Массив из Строка - дополняется правилом, если оно есть и еще не добавлено
//  Добавленные - Соответствие - добавленные ключи
//
Процедура ДобавитьПравило(Правила, Ключ, Результат, Добавленные)

	Правило = Правила.Получить(Ключ);
	Если Правило <> Неопределено И Добавленные.Получить(Ключ) = Неопределено Тогда
		Добавленные.Вставить(Ключ, Истина);
		Результат.Добавить(Правило);
	КонецЕсли;

КонецПроцедуры

Функция РеквизитМетаданных(Владелец, ИмяПоля)

	Для Каждого Коллекция Из КоллекцииМетаданных(Владелец) Цикл
		Если Коллекция.Значение = Неопределено ИЛИ Коллекция.Ключ = "ТабличныеЧасти" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Реквизит Из Коллекция.Значение Цикл
			Если ВРег(Реквизит.Имя) = ВРег(ИмяПоля) Тогда
				Возврат Реквизит;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Параметры:
//  Владелец - ОбъектМетаданных - объект или табличная часть
//
// Возвращаемое значение:
//  Структура - КоллекцияОбъектовМетаданных по именам Измерения, Ресурсы, Реквизиты, РеквизитыАдресации,
//              СтандартныеРеквизиты, ТабличныеЧасти в порядке поиска поля; коллекции, которой у владельца нет, -
//              Неопределено
//
Функция КоллекцииМетаданных(Владелец)

	Коллекции = Новый Структура(
		"Измерения, Ресурсы, Реквизиты, РеквизитыАдресации, СтандартныеРеквизиты, ТабличныеЧасти");
	ЗаполнитьЗначенияСвойств(Коллекции, Владелец);

	Возврат Коллекции;

КонецФункции

// Подбирает ресурсы регистра, от которых может происходить поле виртуальной таблицы (КоличествоОстаток,
// СуммаОборотДт...): имя поля - имя ресурса и известное окончание поля виртуальной таблицы.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - регистр
//  ИмяПоля - Строка
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных - подходящие ресурсы; поле однозначно, только если ресурс один
//
Функция РесурсыВиртуальногоПоля(ОбъектМетаданных, ИмяПоля)

	ОкончанияПолей = СтрРазделить(ВРег("Остаток,ОстатокДт,ОстатокКт,РазвернутыйОстатокДт,РазвернутыйОстатокКт,"
		+ "НачальныйОстаток,НачальныйОстатокДт,НачальныйОстатокКт,НачальныйРазвернутыйОстатокДт,"
		+ "НачальныйРазвернутыйОстатокКт,КонечныйОстаток,КонечныйОстатокДт,КонечныйОстатокКт,"
		+ "КонечныйРазвернутыйОстатокДт,КонечныйРазвернутыйОстатокКт,Оборот,ОборотДт,ОборотКт,КорОборот,"
		+ "КорОборотДт,КорОборотКт,Приход,Расход,Дт,Кт"), ",");

	Найденные = Новый Массив;
	Коллекции = КоллекцииМетаданных(ОбъектМетаданных);
	Если Коллекции.Ресурсы = Неопределено Тогда
		Возврат Найденные;
	КонецЕсли;

	Для Каждого Ресурс Из Коллекции.Ресурсы Цикл
		Если СтрНачинаетсяС(ВРег(ИмяПоля), ВРег(Ресурс.Имя))
			И ОкончанияПолей.Найти(ВРег(Сред(ИмяПоля, СтрДлина(Ресурс.Имя) + 1))) <> Неопределено Тогда
			Найденные.Добавить(Ресурс);
		КонецЕсли;
	КонецЦикла;

	Возврат Найденные;

КонецФункции

Функция ГруппаТипаМетаданных(ТипЗначения, Контекст)

	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "Прочий";
	КонецЕсли;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Класс     = СтрРазделить(ПолноеИмя, ".")[0];
	Если Класс = "Перечисление" Тогда
		Возврат "Открытый";
	ИначеЕсли КлассыТокенов().Найти(Класс) = Неопределено Тогда
		Возврат "Прочий";
	ИначеЕсли ЕстьПравила(ПолноеИмя, Контекст) Тогда
		Возврат "СсылкаОбъектаСПравилами";
	КонецЕсли;

	Возврат "СсылкаОбъектаБезПравил";

КонецФункции

// Возвращаемое значение:
//  Массив из Структура - виды объектов метаданных, на объекты и поля которых задаются правила обезличивания:
//   * Класс - Строка - первый сегмент полного имени объекта
//   * Коллекция - Строка - имя коллекции Метаданные
//   * Представление - Строка - вид объектов во множественном числе
//
Функция ВидыОбъектовПравил()

	Виды = Новый Массив;
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"Справочник", "Справочники", НСтр("ru = 'Справочники'")));
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"Документ", "Документы", НСтр("ru = 'Документы'")));
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"ПланВидовХарактеристик", "ПланыВидовХарактеристик", НСтр("ru = 'Планы видов характеристик'")));
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"ПланСчетов", "ПланыСчетов", НСтр("ru = 'Планы счетов'")));
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"ПланВидовРасчета", "ПланыВидовРасчета", НСтр("ru = 'Планы видов расчета'")));
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"ПланОбмена", "ПланыОбмена", НСтр("ru = 'Планы обмена'")));
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"БизнесПроцесс", "БизнесПроцессы", НСтр("ru = 'Бизнес-процессы'")));
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"Задача", "Задачи", НСтр("ru = 'Задачи'")));
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"РегистрСведений", "РегистрыСведений", НСтр("ru = 'Регистры сведений'")));
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"РегистрНакопления", "РегистрыНакопления", НСтр("ru = 'Регистры накопления'")));
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"РегистрБухгалтерии", "РегистрыБухгалтерии", НСтр("ru = 'Регистры бухгалтерии'")));
	Виды.Добавить(Новый Структура("Класс, Коллекция, Представление",
		"РегистрРасчета", "РегистрыРасчета", НСтр("ru = 'Регистры расчета'")));

	Возврат Виды;

КонецФункции

#КонецОбласти

#Область ПреобразованиеЗначений

// Параметры:
//  Ключ - Произвольный - ключ структуры или соответствия, имя колонки
//  Контекст - Структура - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Строка - метка или токен; пустая строка для ключа, который обезличивается не в строку
//
Функция ОбезличенныйКлюч(Ключ, Контекст)

	Результат = ОбезличенноеЗначениеДанных(Ключ, Контекст);
	Если ТипЗнч(Результат) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Параметры:
//  Ссылка - ЛюбаяСсылка - непустая ссылка одного из классов КлассыТокенов
//  Ключ - ДвоичныеДанные
//
// Возвращаемое значение:
//  Строка - токен <ПолноеИмя>·<32 hex>
//
Функция Токен(Ссылка, Ключ)

	ПолноеИмя = Ссылка.Метаданные().ПолноеИмя();
	Блок = ПолучитьБуферДвоичныхДанныхИзHexСтроки(СтрЗаменить(Строка(Ссылка.УникальныйИдентификатор()), "-", ""));

	Возврат ПолноеИмя + РазделительТокена()
		+ ПолучитьHexСтрокуИзБуфераДвоичныхДанных(ПреобразоватьФейстелем(Блок, ПолноеИмя, Ключ, Ложь));

КонецФункции

// Параметры:
//  Значение - Строка
//  Ключ - ДвоичныеДанные
//
// Возвращаемое значение:
//  Строка - метка ~<16 hex>; пустая строка возвращается как есть
//
Функция Метка(Значение, Ключ)

	Если Значение = "" Тогда
		Возврат Значение;
	КонецЕсли;

	ДлинаМетки = 8;
	Части = Новый Массив;
	Части.Добавить(Ключ);
	Части.Добавить(ДвоичныеДанныеUTF8("~"));
	Части.Добавить(ДвоичныеДанныеUTF8(Значение));

	Возврат "~" + ПолучитьHexСтрокуИзБуфераДвоичныхДанных(НачалоХеша(Части, ДлинаМетки));

КонецФункции

#КонецОбласти

#Область Шифрование

// Обратимо шифрует 16 байт уникального идентификатора: сеть Фейстеля из 4 раундов, раундовая функция -
// начало SHA256 от ключа, имени объекта, номера раунда и половины блока.
//
// Параметры:
//  Блок - БуферДвоичныхДанных - 16 байт, не изменяется
//  ПолноеИмя - Строка - полное имя объекта метаданных
//  Ключ - ДвоичныеДанные
//  Обратное - Булево - Истина для обратного преобразования
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - 16 байт
//
Функция ПреобразоватьФейстелем(Блок, ПолноеИмя, Ключ, Обратное)

	ЧислоРаундов  = 4;
	ДлинаПоловины = 8;
	ИмяUTF8       = ДвоичныеДанныеUTF8(ПолноеИмя);
	Левая         = Блок.Прочитать(0, ДлинаПоловины);
	Правая        = Блок.Прочитать(ДлинаПоловины, ДлинаПоловины);

	Для Шаг = 1 По ЧислоРаундов Цикл
		Если Обратное Тогда
			Правая.ЗаписатьПобитовоеИсключительноеИли(0,
				РаундоваяФункция(Ключ, ИмяUTF8, ЧислоРаундов + 1 - Шаг, Левая), ДлинаПоловины);
		Иначе
			Левая.ЗаписатьПобитовоеИсключительноеИли(0, РаундоваяФункция(Ключ, ИмяUTF8, Шаг, Правая), ДлинаПоловины);
		КонецЕсли;
		Половина = Левая;
		Левая    = Правая;
		Правая   = Половина;
	КонецЦикла;

	Возврат Левая.Соединить(Правая);

КонецФункции

Функция РаундоваяФункция(Ключ, ИмяUTF8, Раунд, Половина)

	Части = Новый Массив;
	Части.Добавить(Ключ);
	Части.Добавить(ИмяUTF8);
	Части.Добавить(ДвоичныеДанныеUTF8(Строка(Раунд)));
	Части.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Половина));

	Возврат НачалоХеша(Части, Половина.Размер);

КонецФункции

// Параметры:
//  Части - Массив из ДвоичныеДанные
//  Длина - Число - число начальных байт хеша
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - начало SHA256 последовательности частей
//
Функция НачалоХеша(Части, Длина)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Для Каждого Часть Из Части Цикл
		Хеширование.Добавить(Часть);
	КонецЦикла;

	Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Хеширование.ХешСумма).Прочитать(0, Длина);

КонецФункции

Функция ДвоичныеДанныеUTF8(Текст)

	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);

КонецФункции

#КонецОбласти

#КонецОбласти
