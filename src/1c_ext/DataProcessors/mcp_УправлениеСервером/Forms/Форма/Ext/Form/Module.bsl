
&НаКлиенте
Перем ФТ_ЭтоFTP, ФТ_ЭтоHTTP, ФТ_ПутьВх, ФТ_ПутьИсх, ФТ_ПараметрыFTP, ФТ_ПараметрыHTTP, ФТ_Соединение;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗначениеВРеквизитФормы(mcp_КонтейнерыПовтИсп.Инструменты(), "ТаблицаИнструментов");
	ЗначениеВРеквизитФормы(mcp_КонтейнерыПовтИсп.Ресурсы()    , "ТаблицаРесурсов");
	ЗначениеВРеквизитФормы(mcp_КонтейнерыПовтИсп.Промпты()    , "ТаблицаПромптов");

	// Файловый транспорт (тестовый). Значения адреса/интервала восстанавливаются
	// автосохранением данных формы, поэтому здесь их не трогаем.
	ФТ_Запущен = Ложь;
	ФТ_Состояние = "Остановлен";

	НС_ЗаполнитьНаСервере();
	КМ_ЗаполнитьНаСервере();

КонецПроцедуры

#Область Настройки

// Вкладка «Настройки»: список форм настроек, которые объявили обработки-контейнеры методом
// ДобавитьФормыНастроек в модуле менеджера (см. mcp_Метаданные.ЗаполнитьТаблицуФормНастроек).
// Показываются все формы сразу, чтобы пользователю не нужно было знать, у какого инструмента
// есть настройки. Колонка «Компонент» — расширение, в котором лежит обработка-контейнер.

&НаСервере
Процедура НС_ЗаполнитьНаСервере()

	НС_Настройки.Очистить();
	СвоеРасширение = Метаданные.Обработки.mcp_УправлениеСервером.РасширениеКонфигурации();

	Для Каждого СтрокаФормы Из mcp_КонтейнерыПовтИсп.ФормыНастроек() Цикл
		Строка = НС_Настройки.Добавить();
		Строка.Заголовок = СтрокаФормы.Заголовок;
		Строка.ИмяКоманды = СтрокаФормы.ИмяКоманды;
		Строка.ПутьКФорме = СтрокаФормы.ПутьКФорме;
		Строка.Компонент = НС_ИмяКомпонента(СтрокаФормы.ИмяОбработкиКонтейнера, СвоеРасширение);
	КонецЦикла;

	ЕстьНастройки = НС_Настройки.Количество() > 0;
	Элементы.НС_ТаблицаНастроек.Видимость = ЕстьНастройки;
	Элементы.НС_НетНастроек.Видимость = НЕ ЕстьНастройки;

КонецПроцедуры

// Представление расширения, в котором лежит обработка-контейнер: синоним компонента,
// для обработок основного расширения — «MCP-сервер».
&НаСервереБезКонтекста
Функция НС_ИмяКомпонента(ИмяОбработки, СвоеРасширение)

	Обработка = Метаданные.Обработки.Найти(ИмяОбработки);
	Если Обработка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Расширение = Обработка.РасширениеКонфигурации();
	Если Расширение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если СвоеРасширение <> Неопределено И Расширение.Имя = СвоеРасширение.Имя Тогда
		Возврат "MCP-сервер";
	КонецЕсли;

	Возврат ?(ПустаяСтрока(Расширение.Синоним), Расширение.Имя, Расширение.Синоним);

КонецФункции

&НаКлиенте
Процедура НС_Открыть(Команда)

	Строка = Элементы.НС_ТаблицаНастроек.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите настройку в списке.");
		Возврат;
	КонецЕсли;

	НС_ОткрытьФорму(Строка.ПутьКФорме);

КонецПроцедуры

&НаКлиенте
Процедура НС_ТаблицаНастроекВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка = НС_Настройки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка <> Неопределено Тогда
		НС_ОткрытьФорму(Строка.ПутьКФорме);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НС_ОткрытьФорму(ПутьКФорме)

	Если НЕ ПустаяСтрока(ПутьКФорме) Тогда
		ОткрытьФорму(ПутьКФорме, , ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Компоненты

// Вкладка «Компоненты»: поставка и включение расширений-компонентов. Вся логика — в модуле менеджера
// обработки mcp_Компоненты (Компоненты, ПроверитьКомпонент, УстановитьКомпонент, УстановитьАктивность);
// форма только вызывает API, показывает результат и предлагает перезапуск сеанса.

&НаКлиенте
Процедура КМ_ОбновитьСписок(Команда)

	КМ_ЗаполнитьНаСервере();
	КМ_ОбновитьДоступностьКнопок();

КонецПроцедуры

&НаКлиенте
Процедура КМ_ТаблицаКомпонентовПриАктивизацииСтроки(Элемент)

	КМ_ОбновитьДоступностьКнопок();

КонецПроцедуры

&НаКлиенте
Процедура КМ_Установить(Команда)

	Строка = КМ_ТекущаяСтрока();
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = СтрШаблон("Установить компонент «%1» версии %2?%3После установки потребуется перезапуск сеанса.",
		Строка.Синоним, Строка.ВерсияПоставки, Символы.ПС);
	Оповещение = Новый ОписаниеОповещения("КМ_УстановитьЗавершение", ЭтотОбъект, Строка.ИмяМакета);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура КМ_УстановитьЗавершение(Ответ, ИмяМакета) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	КМ_ПоказатьРезультат(КМ_УстановитьНаСервере(ИмяМакета));

КонецПроцедуры

&НаКлиенте
Процедура КМ_Обновить(Команда)

	Строка = КМ_ТекущаяСтрока();
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = СтрШаблон("Обновить компонент «%1» с версии %2 до %3?%4После обновления потребуется перезапуск сеанса.",
		Строка.Синоним, Строка.ВерсияУстановленная, Строка.ВерсияПоставки, Символы.ПС);
	Оповещение = Новый ОписаниеОповещения("КМ_УстановитьЗавершение", ЭтотОбъект, Строка.ИмяМакета);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура КМ_Включить(Команда)

	КМ_ИзменитьАктивность(Истина);

КонецПроцедуры

&НаКлиенте
Процедура КМ_Отключить(Команда)

	КМ_ИзменитьАктивность(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура КМ_Проверить(Команда)

	Строка = КМ_ТекущаяСтрока();
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(Строка.ИмяМакета) Тогда
		ПоказатьПредупреждение(, "Сторонний компонент: файла в поставке нет, проверять нечего.");
		Возврат;
	КонецЕсли;

	Результат = КМ_ПроверитьНаСервере(Строка.ИмяМакета);
	ПоказатьПредупреждение(, Результат.Сообщение, , "Проверка компонента");

КонецПроцедуры

&НаКлиенте
Процедура КМ_ИзменитьАктивность(Активно)

	Строка = КМ_ТекущаяСтрока();
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = СтрШаблон("%1 компонент «%2»?%3Изменение вступит в силу после перезапуска сеанса.",
		?(Активно, "Включить", "Отключить"), Строка.Синоним, Символы.ПС);
	Если Строка.Сторонний И НЕ Активно Тогда
		// Сторонний компонент находится по подсистеме в метаданных сеанса; у отключённого расширения
		// её нет, поэтому после перезапуска он из этого списка пропадёт (см. mcp_Компоненты.Компоненты).
		ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.ПС
			+ "Это сторонний компонент: после отключения он исчезнет из этого списка."
			+ " Включить его снова можно будет только в списке расширений конфигурации.";
	КонецЕсли;
	ПараметрыВызова = Новый Структура("Имя, Активно", Строка.Имя, Активно);
	Оповещение = Новый ОписаниеОповещения("КМ_ИзменитьАктивностьЗавершение", ЭтотОбъект, ПараметрыВызова);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура КМ_ИзменитьАктивностьЗавершение(Ответ, ПараметрыВызова) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	КМ_ПоказатьРезультат(КМ_УстановитьАктивностьНаСервере(ПараметрыВызова.Имя, ПараметрыВызова.Активно));

КонецПроцедуры

// Показывает результат операции; при успехе перечитывает список и предлагает перезапуск.
//
// Параметры:
//  Результат - Структура - см. mcp_Компоненты.УстановитьКомпонент: Успех, Сообщение, ТребуетсяПерезапуск
//
&НаКлиенте
Процедура КМ_ПоказатьРезультат(Результат)

	Если НЕ Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Сообщение, , "Компоненты");
		Возврат;
	КонецЕсли;

	КМ_ЗаполнитьНаСервере();
	КМ_ОбновитьДоступностьКнопок();

	Если НЕ Результат.ТребуетсяПерезапуск Тогда
		ПоказатьОповещениеПользователя("Компоненты", , Результат.Сообщение);
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("КМ_ПерезапуститьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Результат.Сообщение + Символы.ПС + "Перезапустить сеанс сейчас?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура КМ_ПерезапуститьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗавершитьРаботуСистемы(Истина, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция КМ_ТекущаяСтрока()

	Строка = Элементы.КМ_ТаблицаКомпонентов.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите компонент в списке.");
	КонецЕсли;

	Возврат Строка;

КонецФункции

// Доступность кнопок по состоянию текущей строки (см. состояния в mcp_Компоненты).
&НаКлиенте
Процедура КМ_ОбновитьДоступностьКнопок()

	Строка = Элементы.КМ_ТаблицаКомпонентов.ТекущиеДанные;
	ЕстьСтрока = Строка <> Неопределено;
	Поставляемый = ЕстьСтрока И НЕ ПустаяСтрока(Строка.ИмяМакета);

	Элементы.КМ_КнопкаУстановить.Доступность = Поставляемый И НЕ Строка.Установлен;
	Элементы.КМ_КнопкаОбновить.Доступность = Поставляемый И Строка.Установлен И Строка.Состояние = "есть обновление";
	Элементы.КМ_КнопкаВключить.Доступность = ЕстьСтрока И Строка.Установлен И НЕ Строка.Активен;
	Элементы.КМ_КнопкаОтключить.Доступность = ЕстьСтрока И Строка.Установлен И Строка.Активен;
	Элементы.КМ_КнопкаПроверить.Доступность = Поставляемый;

КонецПроцедуры

&НаСервере
Процедура КМ_ЗаполнитьНаСервере()

	ЗначениеВРеквизитФормы(Обработки.mcp_Компоненты.Компоненты(), "КМ_Компоненты");

КонецПроцедуры

&НаСервереБезКонтекста
Функция КМ_ПроверитьНаСервере(Знач ИмяМакета)

	Возврат Обработки.mcp_Компоненты.ПроверитьКомпонент(ИмяМакета);

КонецФункции

&НаСервереБезКонтекста
Функция КМ_УстановитьНаСервере(Знач ИмяМакета)

	Возврат Обработки.mcp_Компоненты.УстановитьКомпонент(ИмяМакета);

КонецФункции

&НаСервереБезКонтекста
Функция КМ_УстановитьАктивностьНаСервере(Знач Имя, Знач Активно)

	Возврат Обработки.mcp_Компоненты.УстановитьАктивность(Имя, Активно);

КонецФункции

#КонецОбласти

#Область ФайловыйТранспорт

// Механизм файлового транспорта — для тестирования MCP БЕЗ публикации HTTP-сервиса
// на веб-сервере. Клиент периодически опрашивает папку обмена (локальную/UNC или FTP),
// по каждому файлу-запросу из подпапки in вызывает диспетчер на сервере и пишет
// файл-ответ в подпапку out тем же именем.
//
// Третий вид адреса — http://хост:порт — обратный HTTP-транспорт (httppoll):
// вместо папки агент опрашивает листенер Python-прокси (GET /poll) и возвращает
// ответы POST-ом. Для изолированных контуров, куда есть только проброс TCP-порта
// (например, NX-туннель NoMachine).
//
// В базе запрещены синхронные вызовы работы с файлами на клиенте, поэтому управление
// файлами (поиск/создание/удаление) сделано на асинхронных методах "Начать..." через
// цепочки ОписаниеОповещения. Содержимое читается/пишется синхронно (ЧтениеТекста/
// ЗаписьТекста) — это допустимо. FTP-ветка пока синхронная (будет переведена отдельно).

&НаКлиенте
Процедура ФТ_Старт(Команда)

	Если ПустаяСтрока(ФТ_Адрес) Тогда
		ПоказатьПредупреждение(, "Укажите адрес: папку обмена (локальный путь или FTP) либо листенер прокси (http://хост:порт).");
		Возврат;
	КонецЕсли;

	Если ФТ_Запущен Тогда
		Возврат;
	КонецЕсли;

	Доступ = ФТ_РазобратьАдрес(ФТ_Адрес);
	Если Доступ.ЭтоHTTPS Тогда
		ПоказатьПредупреждение(, "https:// не поддерживается — укажите http://хост:порт.");
		Возврат;
	КонецЕсли;
	Если Не Доступ.ПортКорректен Тогда
		ПоказатьПредупреждение(, "Неверный порт в адресе — ожидается число.");
		Возврат;
	КонецЕсли;

	ФТ_ЭтоFTP = Доступ.ЭтоFTP;
	ФТ_ЭтоHTTP = Доступ.ЭтоHTTP;
	ФТ_Соединение = Неопределено;
	ФТ_ПараметрыFTP = Неопределено;
	ФТ_ПараметрыHTTP = Неопределено;
	Если ФТ_ЭтоHTTP Тогда
		ФТ_ПараметрыHTTP = Доступ;
		ФТ_ПутьВх  = "";
		ФТ_ПутьИсх = "";
	ИначеЕсли ФТ_ЭтоFTP Тогда
		ФТ_ПараметрыFTP = Доступ;
		ФТ_ПутьВх  = ФТ_СоединитьПутьURL(Доступ.Путь, "in");
		ФТ_ПутьИсх = ФТ_СоединитьПутьURL(Доступ.Путь, "out");
	Иначе
		ФТ_ПутьВх  = ФТ_СоединитьПуть(Доступ.Путь, "in");
		ФТ_ПутьИсх = ФТ_СоединитьПуть(Доступ.Путь, "out");
	КонецЕсли;

	Если ФТ_ЭтоHTTP Тогда
		// HTTP: ни папок, ни подготовки — запускаемся сразу.
		ФТ_ЗапуститьПослеПодготовки();
	ИначеЕсли ФТ_ЭтоFTP Тогда
		// FTP: подготовка синхронная (временно, до перевода на async).
		Попытка
			ФТ_ПодготовитьПапкиFTP();
		Исключение
			ФТ_Соединение = Неопределено;
			ФТ_Состояние = "Ошибка подготовки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат;
		КонецПопытки;
		ФТ_ЗапуститьПослеПодготовки();
	Иначе
		// Локально: подготовка асинхронная, запуск — в её финале.
		ФТ_ЛокПодготовкаНачать();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФТ_Стоп(Команда)

	ФТ_ОстановитьВнутр();
	ФТ_Состояние = "Остановлен";

КонецПроцедуры

&НаКлиенте
Процедура ФТ_ОбработчикОжидания()

	Если ФТ_ЭтоHTTP Тогда
		ФТ_ТикHTTP();
	ИначеЕсли ФТ_ЭтоFTP Тогда
		ФТ_ТикFTP();
	Иначе
		Оповещение = Новый ОписаниеОповещения("ФТ_ЛокТикПослеПоиска", ЭтотОбъект, , "ФТ_ЛокТикОшибка", ЭтотОбъект);
		НачатьПоискФайлов(Оповещение, ФТ_ПутьВх, "*.json", Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФТ_ПолеАдресНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

