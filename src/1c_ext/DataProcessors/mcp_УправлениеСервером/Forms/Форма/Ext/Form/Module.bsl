КонецПроцедуры

&НаКлиенте
Функция ФТ_ПолныеИмена(НайденныеФайлы)

	Список = Новый Массив;
	Если НайденныеФайлы <> Неопределено Тогда
		Для Каждого Файл Из НайденныеФайлы Цикл
			Список.Добавить(Файл.ПолноеИмя);
		КонецЦикла;
	КонецЕсли;
	Возврат Список;

КонецФункции

#КонецОбласти

#Область ФайловыйТранспортFTP

// FTP-ветка пока СИНХРОННАЯ (FTPСоединение async-API не имеет). Локальные temp-файлы
// вокруг FTP тоже синхронные — под запретом синхронных вызовов работать не будет,
// это будет переведено на async отдельным шагом. Сейчас оставлено как каркас.

&НаКлиенте
Процедура ФТ_ТикFTP()

	// Соединение пересоздаётся на каждый тик: клиентская 1С (WinInet) кеширует
	// листинги каталогов в рамках соединения, и повторные НайтиФайлы возвращают
	// устаревший (пустой) результат — новые файлы запросов не видны.
	ФТ_Соединение = Неопределено;

	Попытка
		ФТ_ПолучитьСоединение();
	Исключение
		ФТ_Состояние = "Ошибка подключения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ФТ_ОстановитьВнутр();
		Возврат;
	КонецПопытки;

	Обработано = 0;
	Попытка
		Обработано = ФТ_ОбработатьВходящиеFTP();
	Исключение
		ФТ_Соединение = Неопределено;
		ФТ_Состояние = "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ФТ_ПеревзвестиТаймер();
		Возврат;
	КонецПопытки;

	ФТ_Состояние = "Запущен, интервал " + Строка(ФТ_ЭффективныйИнтервал()) + " с"
		+ ?(Обработано > 0, "; обработано: " + Строка(Обработано), "");
	ФТ_ПеревзвестиТаймер();

КонецПроцедуры

&НаКлиенте
Функция ФТ_ПолучитьСоединение()

	Если ФТ_Соединение = Неопределено Тогда
		П = ФТ_ПараметрыFTP;
		// 7-й параметр — таймаут (сек), чтобы форма не подвисала на недоступном сервере.
		ФТ_Соединение = Новый FTPСоединение(П.Сервер, П.Порт, П.Пользователь, П.Пароль, , Истина, 30);
	КонецЕсли;
	Возврат ФТ_Соединение;

КонецФункции

&НаКлиенте
Процедура ФТ_ПодготовитьПапкиFTP()

	Соединение = ФТ_ПолучитьСоединение();

	ЕстьВходящие = Ложь;
	ЕстьИсходящие = Ложь;
	Для Каждого FTPФайл Из Соединение.НайтиФайлы(ФТ_ПараметрыFTP.Путь) Цикл
		Если FTPФайл.ЭтоКаталог() Тогда
			Если FTPФайл.Имя = "in" Тогда
				ЕстьВходящие = Истина;
			ИначеЕсли FTPФайл.Имя = "out" Тогда
				ЕстьИсходящие = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Создание терпимо к отказу: листинг у части серверов не показывает подпапки
	// (возвращает сам каталог), а повторный СоздатьКаталог существующего у клиентской
	// 1С падает. Реальную пригодность папок проверит очистка и первый обмен.
	Если Не ЕстьВходящие Тогда
		Попытка
			Соединение.СоздатьКаталог(ФТ_ПутьВх);
		Исключение
			// Каталог уже существует — штатная ситуация.
		КонецПопытки;
	КонецЕсли;
	Если Не ЕстьИсходящие Тогда
		Попытка
			Соединение.СоздатьКаталог(ФТ_ПутьИсх);
		Исключение
			// Каталог уже существует — штатная ситуация.
		КонецПопытки;
	КонецЕсли;

	// Чистим только out/ (старые ответы). in/ трогать нельзя: в stdio-режиме прокси
	// стартует раньше агента, и его ожидающий запрос уже может лежать в in/ —
	// очистка убила бы его, и клиент MCP не дождался бы ответа.
	ФТ_ОчиститьFTPПапку(Соединение, ФТ_ПутьИсх);

КонецПроцедуры

&НаКлиенте
Процедура ФТ_ОчиститьFTPПапку(Соединение, Путь)

	Для Каждого FTPФайл Из Соединение.НайтиФайлы(Путь, "*.json") Цикл
		Если FTPФайл.ЭтоФайл() Тогда
			Соединение.Удалить(FTPФайл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ФТ_ОбработатьВходящиеFTP()

	Соединение = ФТ_ПолучитьСоединение();

	Обработано = 0;
	Для Каждого Файл Из Соединение.НайтиФайлы(ФТ_ПутьВх, "*.json") Цикл

		Если Не Файл.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;

		ФТ_ОбработатьОдинФайлFTP(Соединение, Файл);
		Обработано = Обработано + 1;

	КонецЦикла;

	Возврат Обработано;

КонецФункции

&НаКлиенте
Процедура ФТ_ОбработатьОдинФайлFTP(Соединение, Файл)

	ЛокальныйЗапрос = "";
	ЛокальныйОтвет = "";
	Попытка

		ЛокальныйЗапрос = ПолучитьИмяВременногоФайла("json");
		Соединение.Получить(Файл.ПолноеИмя, ЛокальныйЗапрос);
		Тело = ФТ_ПрочитатьТекст(ЛокальныйЗапрос);

		Ответ = ФТ_ВыполнитьЗапросНаСервере(Тело);

		Если Не ПустаяСтрока(Ответ) Тогда
			ЛокальныйОтвет = ПолучитьИмяВременногоФайла("json");
			ФТ_ЗаписатьТекст(ЛокальныйОтвет, Ответ);
			ВременныйУдалённый = ФТ_ПутьИсх + "/" + Файл.Имя + ".tmp";
			ЦелевойУдалённый   = ФТ_ПутьИсх + "/" + Файл.Имя;
			Соединение.Записать(ЛокальныйОтвет, ВременныйУдалённый);
			Соединение.Переместить(ВременныйУдалённый, ЦелевойУдалённый);
		КонецЕсли;

		Соединение.Удалить(Файл.ПолноеИмя);

	Исключение
		ФТ_УдалитьВременныйФайл(ЛокальныйЗапрос);
		ФТ_УдалитьВременныйФайл(ЛокальныйОтвет);
		ВызватьИсключение;
	КонецПопытки;

	ФТ_УдалитьВременныйФайл(ЛокальныйЗапрос);
	ФТ_УдалитьВременныйФайл(ЛокальныйОтвет);

КонецПроцедуры

&НаКлиенте
Процедура ФТ_УдалитьВременныйФайл(Путь)

	Если ПустаяСтрока(Путь) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Файл = Новый Файл(Путь);
		Если Файл.Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	Исключение
		// Игнорируем: это лишь очистка временного файла.
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ТранспортHTTP

// Обратный HTTP-транспорт (httppoll). В отличие от файловой ветки тик линейный:
// у HTTPСоединение нет асинхронного аналога и ему не нужны временные файлы,
// поэтому под запрет синхронных вызовов на клиенте он не попадает.

&НаКлиенте
Процедура ФТ_ТикHTTP()

	Обработано = 0;
	Попытка
		Обработано = ФТ_ОбработатьОчередьHTTP();
	Исключение
		// Сетевая ошибка (листенер не поднят, туннель отвалился) — не останавливаемся,
		// следующий тик попробует снова.
		ФТ_Состояние = "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ФТ_ПеревзвестиТаймер();
		Возврат;
	КонецПопытки;

	ФТ_Состояние = "Запущен, интервал " + Строка(ФТ_ЭффективныйИнтервал()) + " с"
		+ ?(Обработано > 0, "; обработано: " + Строка(Обработано), "");
	ФТ_ПеревзвестиТаймер();

КонецПроцедуры

// Разгребает очередь прокси до пустого ответа: GET /poll → диспетчер →
// POST /result/<тикет>. Несколько накопившихся запросов уходят за один тик.
&НаКлиенте
Функция ФТ_ОбработатьОчередьHTTP()

	П = ФТ_ПараметрыHTTP;
	// Таймаут 10 с, чтобы форма не подвисала, если туннель молча умер.
	Соединение = Новый HTTPСоединение(П.Сервер, П.Порт, , , , 10);

	Обработано = 0;
	Пока Истина Цикл

		Ответ = Соединение.Получить(Новый HTTPЗапрос("/poll"));
		Если Ответ.КодСостояния <> 200 Тогда
			Прервать; // 204 — очередь пуста
		КонецЕсли;

		Тикет = Ответ.Заголовки["X-MCP-Ticket"];
		Тело  = Ответ.ПолучитьТелоКакСтроку();

		Попытка
			ТелоОтвета = ФТ_ВыполнитьЗапросНаСервере(Тело);
		Исключение
			// На запрос с id агент отвечает ВСЕГДА, иначе прокси будет ждать до таймаута.
			// Сопоставление у прокси по тикету, поэтому ответ дойдёт даже с id = null.
			ТелоОтвета = ФТ_АварийныйОтветJSONRPC(Тело, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Если Не ПустаяСтрока(ТелоОтвета) Тогда // пустой ответ — нотификация, POST не нужен
			ЗапросРезультата = Новый HTTPЗапрос("/result/" + Тикет);
			ЗапросРезультата.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
			ЗапросРезультата.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8);
			Соединение.ОтправитьДляОбработки(ЗапросРезультата);
		КонецЕсли;

		Обработано = Обработано + 1;

	КонецЦикла;

	Возврат Обработано;

КонецФункции

// Формирует JSON-RPC error -32603, когда вызов диспетчера упал с исключением.
// id достаём из тела запроса; не распарсилось — null.
&НаКлиенте
Функция ФТ_АварийныйОтветJSONRPC(ТелоЗапроса, ТекстОшибки)

	Ид = Неопределено;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоЗапроса);
		Разобранный = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Если ТипЗнч(Разобранный) = Тип("Соответствие") Тогда
			Ид = Разобранный.Получить("id");
		КонецЕсли;
	Исключение
		// Тело не разобралось — отвечаем с id = null.
	КонецПопытки;

	ОписаниеОшибки = Новый Структура;
	ОписаниеОшибки.Вставить("code", -32603);
	ОписаниеОшибки.Вставить("message", ТекстОшибки);

	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Ид);
	Ответ.Вставить("error", ОписаниеОшибки);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Ответ);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область ФайловыйТранспортАдрес

// Разбирает адрес в структуру доступа.
// Поддерживает локальный/UNC-путь, FTP-адрес с учётными данными прямо в адресе
// и HTTP-адрес листенера прокси (обратный транспорт httppoll):
//   ftp://пользователь:пароль@хост:порт/путь
//   http://хост:порт
&НаКлиенте
Функция ФТ_РазобратьАдрес(Адрес)

	Результат = Новый Структура("ЭтоFTP, ЭтоHTTP, ЭтоHTTPS, Сервер, Порт, Пользователь, Пароль, Путь, ПортКорректен",
		Ложь, Ложь, Ложь, "", 21, "", "", "", Истина);

	Строка = СокрЛП(Адрес);
	СтрокаНРег = НРег(Строка);

	Если СтрНачинаетсяС(СтрокаНРег, "ftp://") Тогда
		Результат.ЭтоFTP = Истина;
	ИначеЕсли СтрНачинаетсяС(СтрокаНРег, "http://") Тогда
		Результат.ЭтоHTTP = Истина;
		Результат.Порт = 9090; // порт листенера прокси по умолчанию
	ИначеЕсли СтрНачинаетсяС(СтрокаНРег, "https://") Тогда
		Результат.ЭтоHTTPS = Истина; // распознаём, но не поддерживаем — сообщим при старте
		Возврат Результат;
	Иначе
		Результат.Путь = Строка;
		Возврат Результат;
	КонецЕсли;

	БезСхемы = Сред(Строка, СтрНайти(Строка, "://") + 3);

	Авторитет = БезСхемы;
	ПозицияСлеша = СтрНайти(БезСхемы, "/");
	Если ПозицияСлеша > 0 Тогда
		Авторитет = Лев(БезСхемы, ПозицияСлеша - 1);
		Результат.Путь = Сред(БезСхемы, ПозицияСлеша); // с ведущим "/"
	КонецЕсли;
	Если ПустаяСтрока(Результат.Путь) Тогда
		Результат.Путь = "/";
	КонецЕсли;

	ХостЧасть = Авторитет;
	ПозицияСобаки = СтрНайти(Авторитет, "@");
	Если ПозицияСобаки > 0 Тогда
		УчётнаяЧасть = Лев(Авторитет, ПозицияСобаки - 1);
		ХостЧасть = Сред(Авторитет, ПозицияСобаки + 1);
		ПозицияДвоеточия = СтрНайти(УчётнаяЧасть, ":");
		Если ПозицияДвоеточия > 0 Тогда
			Результат.Пользователь = Лев(УчётнаяЧасть, ПозицияДвоеточия - 1);
			Результат.Пароль = Сред(УчётнаяЧасть, ПозицияДвоеточия + 1);
		Иначе
			Результат.Пользователь = УчётнаяЧасть;
		КонецЕсли;
	КонецЕсли;

	ПозицияПорта = СтрНайти(ХостЧасть, ":");
	Если ПозицияПорта > 0 Тогда
		Результат.Сервер = Лев(ХостЧасть, ПозицияПорта - 1);
		ПортСтрока = СокрЛП(Сред(ХостЧасть, ПозицияПорта + 1));
		Если Не ПустаяСтрока(ПортСтрока) Тогда
			Если ФТ_ЦелоеПоложительное(ПортСтрока) Тогда
				Результат.Порт = Число(ПортСтрока);
			Иначе
				Результат.ПортКорректен = Ложь; // непустой и не число — сообщим при старте
			КонецЕсли;
		КонецЕсли;
	Иначе
		Результат.Сервер = ХостЧасть;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Истина, если строка состоит только из цифр (непустая).
&НаКлиенте
Функция ФТ_ЦелоеПоложительное(Стр)

	Для Сч = 1 По СтрДлина(Стр) Цикл
		Если СтрНайти("0123456789", Сред(Стр, Сч, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ФТ_СоединитьПуть(Каталог, Подпапка)

	Разделитель = ?(СтрНайти(Каталог, "\") > 0, "\", "/");
	Результат = Каталог;
	Если Не (СтрЗаканчиваетсяНа(Результат, "\") Или СтрЗаканчиваетсяНа(Результат, "/")) Тогда
		Результат = Результат + Разделитель;
	КонецЕсли;
	Возврат Результат + Подпапка;

КонецФункции

&НаКлиенте
Функция ФТ_СоединитьПутьURL(Каталог, Подпапка)

	Результат = Каталог;
	Если Не СтрЗаканчиваетсяНа(Результат, "/") Тогда
		Результат = Результат + "/";
	КонецЕсли;
	Возврат Результат + Подпапка;

КонецФункции

#КонецОбласти

#КонецОбласти
