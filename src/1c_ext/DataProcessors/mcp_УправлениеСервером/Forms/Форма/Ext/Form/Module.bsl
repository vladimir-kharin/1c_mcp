// Синхронное чтение/запись содержимого (текст, UTF-8). ЗаписьТекста пишет UTF-8 с BOM —
// Python-сторона читает файлы ответа с кодировкой utf-8-sig, BOM снимается прозрачно.
&НаКлиенте
Функция ФТ_ПрочитатьТекст(ПолноеИмя)

	Чтение = Новый ЧтениеТекста(ПолноеИмя, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

