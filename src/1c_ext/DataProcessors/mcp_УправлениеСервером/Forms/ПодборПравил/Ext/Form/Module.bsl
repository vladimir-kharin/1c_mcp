#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ТипЗнч(Параметры.Правила) = Тип("Массив") Тогда
		Отмеченные.ЗагрузитьЗначения(Параметры.Правила);
	КонецЕсли;
	Элементы.Дерево.ИзменятьСоставСтрок = Ложь;
	Элементы.Дерево.РежимВыделения      = РежимВыделенияТаблицы.Множественный;

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоПометка.Имя);
	ОтборОформления = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборОформления.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Дерево.ПолноеИмя");
	ОтборОформления.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборОформления.ПравоеЗначение = "";
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	ЗаполнитьДерево();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)

	ЗаполнитьДерево();
	Если ПустаяСтрока(СтрокаПоиска) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаВида Из Дерево.ПолучитьЭлементы() Цикл
		Элементы.Дерево.Развернуть(СтрокаВида.ПолучитьИдентификатор());
		Для Каждого СтрокаОбъекта Из СтрокаВида.ПолучитьЭлементы() Цикл
			Если СтрокаОбъекта.ПоляЗагружены Тогда
				Элементы.Дерево.Развернуть(СтрокаОбъекта.ПолучитьИдентификатор(), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДерево

&НаКлиенте
Процедура ДеревоПередРазворачиванием(Элемент, Строка, Отказ)

	ДанныеСтроки = Дерево.НайтиПоИдентификатору(Строка);
	Если ДанныеСтроки.ПолноеИмя <> "" И НЕ ДанныеСтроки.ПоляЗагружены Тогда
		ЗагрузитьПоля(Строка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоПометкаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Дерево.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.ПолноеИмя = "" Тогда
		Возврат;
	КонецЕсли;

	ОтметитьПравило(ТекущиеДанные.ПолноеИмя, ТекущиеДанные.Пометка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)

	Закрыть(Отмеченные.ВыгрузитьЗначения());

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыделенные(Команда)

	УстановитьПометкуВыделенных(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуВыделенных(Команда)

	УстановитьПометкуВыделенных(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//  Пометка - Булево - Истина, чтобы отметить выделенные строки; строки без правила пропускаются
//
&НаКлиенте
Процедура УстановитьПометкуВыделенных(Пометка)

	Для Каждого ИдентификаторСтроки Из Элементы.Дерево.ВыделенныеСтроки Цикл
		ДанныеСтроки = Дерево.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ДанныеСтроки = Неопределено ИЛИ ДанныеСтроки.ПолноеИмя = "" Тогда
			Продолжить;
		КонецЕсли;
		ДанныеСтроки.Пометка = Пометка;
		ОтметитьПравило(ДанныеСтроки.ПолноеИмя, Пометка);
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  ПолноеИмя - Строка - правило
//  Пометка - Булево - Истина, чтобы добавить правило в отмеченные, Ложь - убрать
//
&НаКлиенте
Процедура ОтметитьПравило(ПолноеИмя, Пометка)

	ЭлементСписка = Отмеченные.НайтиПоЗначению(ПолноеИмя);
	Если Пометка И ЭлементСписка = Неопределено Тогда
		Отмеченные.Добавить(ПолноеИмя);
	ИначеЕсли НЕ Пометка И ЭлементСписка <> Неопределено Тогда
		Отмеченные.Удалить(ЭлементСписка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДерево()

	Строки = Дерево.ПолучитьЭлементы();
	Строки.Очистить();
	ОтмеченныеПравила = СоответствиеОтмеченных();
	Для Каждого ВидОбъектов Из mcp_Обезличивание.ОбъектыПодбораПравил(СтрокаПоиска) Цикл
		СтрокаВида = Строки.Добавить();
		СтрокаВида.Представление = ВидОбъектов.Представление;
		СтрокаВида.Картинка      = БиблиотекаКартинок[ВидОбъектов.Картинка];
		СтрокаВида.ПоляЗагружены = Истина;
		ДобавитьУзлы(СтрокаВида.ПолучитьЭлементы(), ВидОбъектов.Объекты, ОтмеченныеПравила, Истина);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПоля(Знач ИдентификаторСтроки)

	СтрокаОбъекта = Дерево.НайтиПоИдентификатору(ИдентификаторСтроки);
	Поля = СтрокаОбъекта.ПолучитьЭлементы();
	Поля.Очистить();
	ДобавитьУзлы(Поля, mcp_Обезличивание.ПоляПодбораПравил(СтрокаОбъекта.ПолноеИмя),
		СоответствиеОтмеченных(), Ложь);
	СтрокаОбъекта.ПоляЗагружены = Истина;

КонецПроцедуры

// Параметры:
//  Строки - ДанныеФормыКоллекцияЭлементовДерева - куда добавляются узлы
//  Узлы - Массив из Структура - см. mcp_Обезличивание.ОбъектыПодбораПравил
//  ОтмеченныеПравила - Соответствие - см. СоответствиеОтмеченных
//  ЭтоОбъекты - Булево - Истина для узлов объектов: объект без подобранных полей получает строку-заглушку,
//               чтобы раскрываться и загружать поля
//
&НаСервере
Процедура ДобавитьУзлы(Строки, Узлы, ОтмеченныеПравила, ЭтоОбъекты)

	Для Каждого Узел Из Узлы Цикл
		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.ПолноеИмя     = Узел.ПолноеИмя;
		НоваяСтрока.Представление = Узел.Представление;
		НоваяСтрока.Картинка      = БиблиотекаКартинок[Узел.Картинка];
		НоваяСтрока.Пометка       = ОтмеченныеПравила.Получить(Узел.ПолноеИмя) <> Неопределено;
		Если Узел.Вложенные <> Неопределено Тогда
			НоваяСтрока.ПоляЗагружены = Истина;
			ДобавитьУзлы(НоваяСтрока.ПолучитьЭлементы(), Узел.Вложенные, ОтмеченныеПравила, Ложь);
		ИначеЕсли ЭтоОбъекты Тогда
			НоваяСтрока.ПолучитьЭлементы().Добавить();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - отмеченное правило
//   * Значение - Булево - Истина
//
&НаСервере
Функция СоответствиеОтмеченных()

	ОтмеченныеПравила = Новый Соответствие;
	Для Каждого ЭлементСписка Из Отмеченные Цикл
		ОтмеченныеПравила.Вставить(ЭлементСписка.Значение, Истина);
	КонецЦикла;

	Возврат ОтмеченныеПравила;

КонецФункции

#КонецОбласти
