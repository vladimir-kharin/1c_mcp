	Контекст = Новый Структура("Список, Индекс, Этап", ФТ_ПолныеИмена(НайденныеФайлы), 0, "in");
	ФТ_ЛокПодготовкаУдалитьШаг(Контекст);

КонецПроцедуры

&НаКлиенте
Процедура ФТ_ЛокПодготовкаУдалитьШаг(Контекст)

	Если Контекст.Индекс > Контекст.Список.ВГраница() Тогда
		Если Контекст.Этап = "in" Тогда
			Оповещение = Новый ОписаниеОповещения("ФТ_ЛокПодготовкаЧисткаOut", ЭтотОбъект, , "ФТ_ЛокПодготовкаОшибка", ЭтотОбъект);
			НачатьПоискФайлов(Оповещение, ФТ_ПутьИсх, "*.json", Ложь);
		Иначе
			ФТ_ЗапуститьПослеПодготовки();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Файл = Контекст.Список[Контекст.Индекс];
	Контекст.Индекс = Контекст.Индекс + 1;
	Оповещение = Новый ОписаниеОповещения("ФТ_ЛокПодготовкаУдалитьПосле", ЭтотОбъект, Контекст, "ФТ_ЛокПодготовкаОшибка", ЭтотОбъект);
	НачатьУдалениеФайлов(Оповещение, Файл);

КонецПроцедуры

