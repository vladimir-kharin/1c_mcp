#Область ПрограммныйИнтерфейс

// Возвращает таблицу инструментов (с кешированием)
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица инструментов с колонками:
//   * ИмяОбработкиКонтейнера - Строка
//   * Имя - Строка
//   * Описание - Строка
//   * СхемаПараметров - Строка
//
Функция Инструменты() Экспорт
	
	ТаблицаИнструментов = mcp_Метаданные.ТаблицаИнструментов();
	mcp_Метаданные.ЗаполнитьТаблицуИнструментов(ТаблицаИнструментов);
	
	Возврат ТаблицаИнструментов;
	
КонецФункции

