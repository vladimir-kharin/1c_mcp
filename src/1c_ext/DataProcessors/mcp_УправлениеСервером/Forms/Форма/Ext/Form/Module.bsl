КонецПроцедуры

&НаКлиенте
Процедура ФТ_ЛокПодготовкаОшибка(ИнформацияОбОшибке, СтандартнаяОбработка, ДопП) Экспорт

	СтандартнаяОбработка = Ложь;
	ФТ_Состояние = "Ошибка подготовки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	// Не запускаемся, поля не блокируем.

КонецПроцедуры

// Тик (async): найти *.json во входящих → обработать по очереди → перевзвести таймер.
&НаКлиенте
Процедура ФТ_ЛокТикПослеПоиска(НайденныеФайлы, ДопП) Экспорт

	Очередь = Новый Массив;
	Если НайденныеФайлы <> Неопределено Тогда
		Для Каждого Файл Из НайденныеФайлы Цикл
			Очередь.Добавить(Файл);
		КонецЦикла;
	КонецЕсли;

	Контекст = Новый Структура("Очередь, Индекс, Обработано", Очередь, 0, 0);
	ФТ_ЛокТикШаг(Контекст);

КонецПроцедуры

&НаКлиенте
Процедура ФТ_ЛокТикШаг(Контекст)

	Если Контекст.Индекс > Контекст.Очередь.ВГраница() Тогда
		ФТ_Состояние = "Запущен, интервал " + Строка(ФТ_ЭффективныйИнтервал()) + " с"
			+ ?(Контекст.Обработано > 0, "; обработано: " + Строка(Контекст.Обработано), "");
		ФТ_ПеревзвестиТаймер();
		Возврат;
	КонецЕсли;

	ТекущийФайл = Контекст.Очередь[Контекст.Индекс];

	Тело = ФТ_ПрочитатьТекст(ТекущийФайл.ПолноеИмя);
	Ответ = ФТ_ВыполнитьЗапросНаСервере(Тело);

	// Нотификации ответа не имеют (диспетчер вернул пустую строку) — файл-ответ не пишем.
	Если Не ПустаяСтрока(Ответ) Тогда
		ФТ_ЗаписатьТекст(ФТ_СоединитьПуть(ФТ_ПутьИсх, ТекущийФайл.Имя), Ответ);
	КонецЕсли;

	Контекст.Обработано = Контекст.Обработано + 1;
	Контекст.Индекс = Контекст.Индекс + 1;

	// Удаляем запрос асинхронно, затем к следующему файлу.
	Оповещение = Новый ОписаниеОповещения("ФТ_ЛокТикПослеУдаления", ЭтотОбъект, Контекст, "ФТ_ЛокТикОшибка", ЭтотОбъект);
	НачатьУдалениеФайлов(Оповещение, ТекущийФайл.ПолноеИмя);

КонецПроцедуры

&НаКлиенте
Процедура ФТ_ЛокТикПослеУдаления(Контекст) Экспорт

	ФТ_ЛокТикШаг(Контекст);

КонецПроцедуры

&НаКлиенте
Процедура ФТ_ЛокТикОшибка(ИнформацияОбОшибке, СтандартнаяОбработка, ДопП) Экспорт

